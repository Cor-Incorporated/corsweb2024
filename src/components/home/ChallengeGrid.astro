---
import { getCurrentLocale, getTranslations, getLocalizedUrl } from '../../utils/i18n';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);

// 各カードのリンク先は homeChallenges.items[].link（サイト内のパス）に持つ。並べ替えても
// カードとリンクがずれない。5 言語で同じ並びか、リンク先が実在するかは home-page.test.ts で照合する。
// カード全体をクリック可能にしつつ、リンクのテキストはタイトルのみに限定する（説明文を <a> 配下に
// 含めない）。可視文テキスト監査が a[href] の innerText を測るため、長い説明文をリンクに含めると
// 末尾行が孤立断片として弾かれる。
---

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-8 sm:gap-12">
      <div class="flex max-w-3xl flex-col gap-3 sm:gap-4" data-reveal>
        <p
          class="text-sm font-medium uppercase tracking-widest text-primary-600 dark:text-primary-400"
        >
          {t.homeChallenges.eyebrow}
        </p>
        <h2 class="text-balance text-2xl font-medium tracking-tight sm:text-4xl">
          {t.homeChallenges.title}
        </h2>
      </div>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
        {
          t.homeChallenges.items.map((item, i) => (
            <li
              class="group relative flex h-full flex-col gap-2 rounded-3xl bg-primary-500/10 p-5 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg dark:bg-primary-400/10 sm:gap-3 sm:p-6"
              data-reveal
              style={`--reveal-delay:${(0.1 + i * 0.08).toFixed(2)}s`}
            >
              <div class="flex items-start justify-between gap-2">
                <h3 class="text-balance text-lg font-medium tracking-tight">
                  <a
                    href={getLocalizedUrl(item.link, currentLocale)}
                    class="after:absolute after:inset-0 after:rounded-3xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600"
                  >
                    {item.title}
                  </a>
                </h3>
                <span aria-hidden="true" class="mt-0.5 shrink-0 text-primary-600 transition group-hover:translate-x-0.5 dark:text-primary-400">→</span>
              </div>
              <p class="text-pretty text-sm leading-relaxed text-primary-950/70 dark:text-primary-200/70 sm:text-base">
                {item.description}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

---
import { getCurrentLocale, getTranslations, getLocalizedUrl } from '../../utils/i18n';
import { getContactUrl, ENGINEER_CAFE_CASE_PATH, FUKUOKA100_PAGE_URL } from '../../config/site';
import PenguinWalker from './PenguinWalker.astro';
import IndustryEntry from './IndustryEntry.astro';
import Fukuoka100Emblem from '../common/Fukuoka100Emblem.astro';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);

// 最初の画面には、使う技術や製品名（ローカルLLM・PoC・Grift など）を出さず、改善できる業務と
// 信頼の材料（審査・実績・選出）を置く（#414、2026-10-26 の社内レビュー）。文言の検査は
// src/utils/__tests__/home-page.test.ts。
// trustBadges の id ごとのリンク先。id は全言語で同じ並び（同じテストで照合する）。
const BADGE_HREFS: Record<string, string> = {
  isms: getLocalizedUrl('/security', currentLocale),
  'engineer-cafe': getLocalizedUrl(ENGINEER_CAFE_CASE_PATH, currentLocale),
  fukuoka: FUKUOKA100_PAGE_URL, // 福岡発 → 100選の特設ページ（エンブレムと同じ遷移先）
};

// 見出しの大きさ（2026-10-26 に測って決めた）。
//
// 7vw のときは 1440×900 で h1 が 100.8px、ヒーローが 1,132px と画面の高さを超え、「大きすぎる」と
// 言われていた。5vw にすると 1440px で 72px。その後、ブラウザの枠とタスクバーを引いたパソコンの窓（1366×657 など）でも
// 5 業種の入口を最初の画面に入れるため、CJK は 4.5vw にした（1366px で 61px、1440px で 65px）。CJK（ja/zh/ko）は
// #302 のとおり上限を置かずに画面幅へ比例させる（外部モニターで頭打ちにならない）。15rem(240px) は 4800px 以上でだけ効く安全弁。
// ラテン系（en/es）はタイトルが折り返すので、比率を下げたうえで 5.5rem(88px) を上限にする。
// 下限はスマホ幅で効く。ja/zh/ko は 2.15rem（390px では 34.4px）、en/es は 1.5rem（24px）。
//
// 注意1: h1 の text-balance は Tailwind 3.4 の機能で、本プロジェクト（3.3.3）では CSS が出ない。
//        折り返しは font-size と枠幅だけで決まる（バージョンを上げるとこの前提が変わる）。
// 注意2: section に overflow-hidden があるため、横溢れは scrollWidth では検知できない（黙って
//        切られる）。検証する場合は行の矩形とビューポートを直接比較すること。
const isCjkLocale = ['ja', 'zh', 'ko'].includes(currentLocale);
const heroTitleSizeClass = isCjkLocale
  ? 'text-[clamp(2.15rem,4.5vw,15rem)]'
  : 'text-[clamp(1.5rem,4.5vw,5.5rem)]';

// 5 業種の入口を最初の画面に入れるための、言語ごとの余白と文字の大きさ。
// en・es は説明の文と主ボタンの文が長いので、スマホでは en・es だけを詰める（ブラウザの枠を引いたスマホの高さ）。
// パソコンでは、ブラウザの枠とタスクバーを引いた窓（1366×657 など）でも入口が入るよう、ja・zh・ko の上の余白と
// 間隔を en・es と同じにし、説明の文を 5 言語とも 18px（sm:text-lg）にする。
// 測るのは e2e/first-view.spec.ts（画面の大きさ 14 とパソコンの窓 5 × 5 言語。窓は入る言語だけを見る）。
const heroSpacing = isCjkLocale
  ? {
      section: 'pt-4 sm:pt-12',
      column: 'gap-4 sm:gap-6',
      kicker: 'text-sm tracking-widest',
      titleBlock: 'gap-5 sm:gap-5',
      subtitle: 'text-[15px] leading-relaxed sm:text-lg sm:leading-relaxed',
      primaryCta: 'py-3 text-base sm:py-4 sm:text-lg',
    }
  : {
      section: 'pt-1 sm:pt-12',
      column: 'gap-2 sm:gap-6',
      kicker: 'text-xs leading-tight tracking-wide sm:text-sm sm:tracking-widest',
      titleBlock: 'gap-2 sm:gap-5',
      // パソコンの文字は ja・zh・ko と同じ大きさのまま（折り返しの位置を変えない）
      subtitle: 'text-[13px] leading-normal sm:text-lg sm:leading-relaxed',
      primaryCta: 'py-2.5 text-sm sm:py-4 sm:text-lg',
    };

// 主CTA: 機密データAI活用診断（ADR-0011）。副は実績（信頼の材料を上へ寄せる。PoC の入口は締めに置く）
const primaryHref = getContactUrl(currentLocale, {
  intent: 'confidential-ai-assessment',
  source: 'home-hero',
});
const secondaryHref = getLocalizedUrl('/works', currentLocale);
---

{/* 高さは中身で決める（以前の min-h-[88vh] は外した）。下の余白はペンギンが歩く場所。 */}
{/* 5 業種の入口（IndustryEntry）は主ボタンのすぐ下。最初の画面に 5 つとも入ることを
    e2e/first-view.spec.ts が測る。スマホでは「実績を見る」を入口の下に出し、3 つの短い文とエンブレムが続く。
    並べ替えに CSS の order を使わない（見た目と Tab の順がずれるため）。 */}
<section class={`relative isolate flex items-center overflow-hidden pb-28 sm:pb-32 ${heroSpacing.section}`}>
  <div class="relative z-10 mx-auto w-full max-w-2xl px-4 sm:px-6 lg:max-w-content lg:px-8 2xl:max-w-content">
    <div class={`flex flex-col items-center text-center ${heroSpacing.column}`} data-hero-content>
      <p
        class={`font-medium uppercase text-primary-600 dark:text-primary-400 ${heroSpacing.kicker}`}
        data-reveal
        style="--reveal-delay:0.05s"
      >
        {t.homeHero.kicker}
      </p>
      <div class={`flex max-w-5xl flex-col items-center 2xl:max-w-content ${heroSpacing.titleBlock}`}>
        {/* 即描画(LCP死守)のため演出は付けない。サイズは heroTitleSizeClass が全て持つ（ベタ書きの
            text-[...] を足すと、後勝ちがクラス属性の順ではなく CSS の出力順で決まるため、無言で競合する）。 */}
        <h1
          class={`text-balance font-semibold leading-[1.05] tracking-tight ${heroTitleSizeClass}`}
          set:html={t.homeHero.title}
        />
        {/* theme.fontSize が [size, lineHeight] のタプル指定のため text-lg は line-height も出し、
            後勝ちで leading-relaxed を打ち消す。sm:leading-relaxed で戻す。 */}
        <p class={`max-w-3xl text-pretty text-primary-950/70 dark:text-primary-200/70 ${heroSpacing.subtitle}`} set:html={t.homeHero.subtitle} data-reveal style="--reveal-delay:0.15s"></p>
      </div>
      <div class="flex w-full flex-col items-center gap-3 sm:w-auto sm:flex-row sm:justify-center sm:gap-4" data-reveal style="--reveal-delay:0.3s">
        <a
          href={primaryHref}
          data-hero-primary-cta
          class={`inline-flex min-h-[48px] w-full max-w-sm items-center justify-center rounded-full border border-transparent bg-[#2d4a6b] px-6 text-center font-semibold text-white shadow-sm transition hover:bg-[#1e3350] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2d4a6b] sm:w-auto sm:px-8 ${heroSpacing.primaryCta}`}
        >
          {t.homeHero.primaryCta}
        </a>
        {/* パソコンでは主ボタンの横。スマホでは入口の下に同じリンクを出す（見た目と Tab の順をそろえる）。
            スマホ用は max-sm: で出す。「sm 以上で隠す」の class をこのサイトの source に書くと、その CSS ができ、
            locale の説明の文の改行（同じ class を付けた br）がパソコンで消えて、空白も無くなる（「documents.Cor.Inc.」）。
            Tailwind は comment の中の文字も拾うので、ここにもその class 名を書かない。 */}
        <a href={secondaryHref} class="hidden min-h-[48px] w-full max-w-sm items-center justify-center rounded-full px-5 py-3 text-center text-base font-medium text-primary-950 underline-offset-4 transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:text-primary-200 sm:w-auto sm:inline-flex">
          {t.homeHero.secondaryCta}<span aria-hidden="true">&nbsp;→</span>
        </a>
      </div>
      <IndustryEntry />
      <a href={secondaryHref} class="hidden min-h-[48px] w-full max-w-sm items-center justify-center rounded-full px-5 py-3 text-center text-base font-medium text-primary-950 underline-offset-4 transition hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:text-primary-200 sm:w-auto max-sm:inline-flex" data-reveal style="--reveal-delay:0.35s">
        {t.homeHero.secondaryCta}<span aria-hidden="true">&nbsp;→</span>
      </a>
      <ul class="flex flex-wrap items-center justify-center gap-2 sm:gap-3" data-reveal style="--reveal-delay:0.45s">
        {
          t.homeHero.trustBadges.map((badge) => {
            const href = BADGE_HREFS[badge.id];
            if (!href) throw new Error(`homeHero.trustBadges: unknown id "${badge.id}" (${currentLocale})`);
            const isExternal = href.startsWith('http');
            return (
              <li>
                <a
                  href={href}
                  target={isExternal ? '_blank' : undefined}
                  rel={isExternal ? 'noopener noreferrer' : undefined}
                  class="inline-flex rounded-full bg-primary-500/10 px-3 py-1 text-xs text-primary-950/70 transition hover:bg-primary-500/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:bg-primary-400/10 dark:text-primary-200/70 dark:hover:bg-primary-400/20 sm:px-4 sm:py-1.5 sm:text-sm"
                >
                  {badge.label}
                </a>
              </li>
            );
          })
        }
      </ul>
      {/* 福岡を代表する企業100選 公式エンブレム（#276 / #304）。掲載条件（クリック遷移・掲載期限）は
          コンポーネント側で一括して担保しているため、ここでは配置とサイズだけ指定する。 */}
      <Fukuoka100Emblem imgClass="h-12 w-auto sm:h-16" data-reveal style="--reveal-delay:0.5s" />
    </div>
  </div>
  {/* ロゴのペンギンがヒーロー下部を歩く演出（装飾）。クリックで飛び立ち、下から再登場。 */}
  <PenguinWalker bubble={t.homeHero.penguinBubble} locale={currentLocale} />
</section>

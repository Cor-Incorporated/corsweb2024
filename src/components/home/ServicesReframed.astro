---
import { getCurrentLocale, getTranslations, getLocalizedUrl } from '../../utils/i18n';
import { getGriftUrl } from '../../config/site';
import { getServicePage, getServiceUrl } from '../../config/services';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);

// services2026.items（全言語同一の並び＝事業の5本柱、ADR-0022）に対応する関連ページ。
// サービスのページ（ADR-0024）と /company は各言語版があるため localize、Grift は env 経由（ADR-0010）。
// ハードウェアAIは開発・実証の準備段階で紹介ページが無いため、リンクを付けない（null）。
const SERVICE_HREFS: (string | null)[] = [
  getGriftUrl('/', { intent: 'grift-team-beta', source: 'services-reframed' }), // Grift
  getServiceUrl(getServicePage('serviceLocalLlm'), currentLocale), // ローカルLLM・セキュアAI → PoC のページ
  null, // ハードウェアAI
  getServiceUrl(getServicePage('serviceAiDev'), currentLocale), // AI受託開発・導入支援 → AI基盤構築・AI受託のページ
  getLocalizedUrl('/company', currentLocale), // 教育・地域 → 会社概要（事業の柱）
];
// カード全体のリンクとは別に置く、同じ柱のもう 1 つの入口。ローカルLLM・セキュアAI の柱には、PoC の前の診断がある。
const SUB_LINKS: ({ name: string; href: string } | null)[] = [
  null,
  { name: t.nav.serviceAssessment, href: getServiceUrl(getServicePage('serviceAssessment'), currentLocale) },
  null,
  null,
  null,
];
---

<section class="py-24 sm:py-32">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col gap-10 sm:gap-12">
      <h2 class="max-w-3xl text-3xl font-medium tracking-tight sm:text-4xl" data-reveal>
        {t.services2026.title}
      </h2>
      <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          t.services2026.items.map((item, i) => {
            const href = SERVICE_HREFS[i];
            const subLink = SUB_LINKS[i];
            const isExternal = Boolean(href && href.startsWith('http'));
            {/* カード全体をクリック可能にしつつ、リンクのテキストはタイトルのみに限定する
                （説明文を <a> 配下に含めない）。可視文テキスト監査が a[href] の innerText を
                測るため、長い説明文をリンクに含めると末尾行が孤立断片として弾かれる。 */}
            return (
              <li
                class="group relative flex h-full flex-col gap-3 rounded-3xl bg-primary-500/10 p-6 shadow-sm transition duration-200 hover:-translate-y-1 hover:shadow-lg dark:bg-primary-400/10"
                data-reveal
                style={`--reveal-delay:${(0.1 + i * 0.08).toFixed(2)}s`}
              >
                <div class="flex items-start justify-between gap-2">
                  <h3 class="text-balance text-lg font-medium tracking-tight">
                    {href ? (
                      <a
                        href={href}
                        target={isExternal ? '_blank' : undefined}
                        rel={isExternal ? 'noopener noreferrer' : undefined}
                        class="after:absolute after:inset-0 after:rounded-3xl focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600"
                      >
                        {item.name}
                      </a>
                    ) : (
                      item.name
                    )}
                  </h3>
                  {href && (
                    <span aria-hidden="true" class="mt-0.5 shrink-0 text-primary-600 transition group-hover:translate-x-0.5 dark:text-primary-400">{isExternal ? '↗' : '→'}</span>
                  )}
                </div>
                <p class="text-base text-primary-950/70 dark:text-primary-200/70">
                  {item.description}
                </p>
                {/* カード全体を覆うリンクの上に重ねる（relative z-10）。押すとカードではなくこちらへ行く */}
                {subLink && (
                  <a
                    href={subLink.href}
                    class="relative z-10 mt-auto inline-flex w-fit items-center gap-1 text-sm font-medium text-primary-600 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:text-primary-400"
                  >
                    {subLink.name}
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

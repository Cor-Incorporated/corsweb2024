---
interface Props {
  value: string;
}

const { value } = Astro.props;
const mailbox = 'company@cor-jp.com';
const index = value.indexOf(mailbox);
---

{/* Cloudflareは標準の本文中のアドレスをJSで復号する。noscriptは変換せずに配信する。 */}
{index < 0 ? value : <>{value.slice(0, index)}<span class="privacy-decoded-address">{mailbox}</span><noscript>{mailbox}</noscript>{value.slice(index + mailbox.length)}</>}

<style>
  @media (scripting: none) {
    .privacy-decoded-address { display: none; }
  }
</style>

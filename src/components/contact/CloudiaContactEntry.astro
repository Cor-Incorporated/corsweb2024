---
import { CONTACT_CALENDAR_VISIBLE } from '../../config/contact';
import { getCurrentLocale, type Locale } from '../../utils/i18n';

const currentLocale = getCurrentLocale(Astro.url);
const chatUrl = new URL('/contact/chat/', Astro.url);
chatUrl.searchParams.set('source', 'corsweb-contact-primary');
chatUrl.searchParams.set('locale', currentLocale);
const incomingIntent = Astro.url.searchParams.get('intent');
if (incomingIntent) chatUrl.searchParams.set('intent', incomingIntent);

// この <details> の中身は所在地と、（PUBLIC_GCAL_ID がある時だけ）代表スケジュールのカレンダー。
// 問い合わせは Cloudia に一本化した（ADR-0005 §6 撤回・2026-09-13）ため、ここを「代替の連絡先」と
// 名乗らせない。カレンダーが出ない環境では時間帯に触れない文言へ切り替え、中身と食い違わせない。
// この 2 つも下の ENTRY_COPY も全ロケール分を用意する
// （satisfies により、6言語目を足したときに翻訳漏れが型エラーになる）。
type FallbackCopy = { title: string; description: string };
const FALLBACK_WITH_CALENDAR = {
  ja: {
    title: '所在地・打ち合わせ可能な時間を見る',
    description:
      'お問い合わせはCloudia（AIチャット）で承っています。ここでは所在地と、打ち合わせ可能な時間帯をご確認いただけます。',
  },
  en: {
    title: 'Our location and available times',
    description:
      'Inquiries are handled through Cloudia, our AI chat. Here you can check our location and the times we are available to meet.',
  },
  zh: {
    title: '查看公司地址与可洽谈时间',
    description:
      '咨询请通过 AI 聊天助手 Cloudia 提出。此处可确认公司地址与可安排洽谈的时间段。',
  },
  ko: {
    title: '소재지·미팅 가능 시간 보기',
    description:
      '문의는 AI 챗봇 Cloudia에서 받고 있습니다. 여기에서는 소재지와 미팅이 가능한 시간대를 확인하실 수 있습니다.',
  },
  es: {
    title: 'Nuestra ubicación y horarios disponibles',
    description:
      'Las consultas se atienden a través de Cloudia, nuestro chat con IA. Aquí puede consultar nuestra ubicación y los horarios en que podemos reunirnos.',
  },
} as const satisfies Record<Locale, FallbackCopy>;

const FALLBACK_WITHOUT_CALENDAR = {
  ja: {
    title: '所在地を見る',
    description: 'お問い合わせはCloudia（AIチャット）で承っています。ここでは所在地をご確認いただけます。',
  },
  en: {
    title: 'Our location',
    description: 'Inquiries are handled through Cloudia, our AI chat. Here you can check our location.',
  },
  zh: {
    title: '查看公司地址',
    description: '咨询请通过 AI 聊天助手 Cloudia 提出。此处可确认公司地址。',
  },
  ko: {
    title: '소재지 보기',
    description: '문의는 AI 챗봇 Cloudia에서 받고 있습니다. 여기에서는 소재지를 확인하실 수 있습니다.',
  },
  es: {
    title: 'Nuestra ubicación',
    description: 'Las consultas se atienden a través de Cloudia, nuestro chat con IA. Aquí puede consultar nuestra ubicación.',
  },
} as const satisfies Record<Locale, FallbackCopy>;

const fallbackCopy: FallbackCopy = CONTACT_CALENDAR_VISIBLE
  ? FALLBACK_WITH_CALENDAR[currentLocale]
  : FALLBACK_WITHOUT_CALENDAR[currentLocale];

// 以前は ja/非ja の 2 分岐で、zh・ko・es のお問い合わせページに英語の案内が出ていた。
// 説明文は「開いた後に何が起きるか」を書く（目的を選ぶ → 質問に答える → 担当者へ引き継ぐ、
// 連絡先は最後だけ）。Cloudia 自体は日本語と英語だけなので、その旨は各言語で書く。
// 返信の目安（原則3営業日以内）はページの見出しの説明（contactPage）が書いているので、ここでは繰り返さない。
type EntryCopy = { eyebrow: string; title: string; description: string; cta: string };
const ENTRY_COPY = {
  ja: {
    eyebrow: 'Contact with Cloudia',
    title: 'まずはCloudiaにご相談ください',
    description:
      'ご相談の目的を選び、いくつかの質問に答えていただくと、Cloudiaが内容を整理して担当者へ引き継ぎます。連絡先をお伺いするのは最後だけです。日本語と英語に対応しています。',
    cta: 'Cloudiaを開く',
  },
  en: {
    eyebrow: 'Contact with Cloudia',
    title: 'Start with a conversation with Cloudia',
    description:
      'Choose the purpose of your inquiry and answer a few questions. Cloudia organizes your inquiry and hands it to our team. We ask for your contact details only at the end. Cloudia supports Japanese and English.',
    cta: 'Open Cloudia',
  },
  zh: {
    eyebrow: 'Contact with Cloudia',
    title: '请先与 Cloudia 沟通',
    description:
      '选择咨询目的并回答几个问题后，Cloudia 会整理内容并转交给负责人。联系方式只在最后一步填写。Cloudia 支持日语和英语。',
    cta: '打开 Cloudia',
  },
  ko: {
    eyebrow: 'Contact with Cloudia',
    title: '먼저 Cloudia에게 상담해 주세요',
    description:
      '문의 목적을 선택하고 몇 가지 질문에 답하시면 Cloudia가 내용을 정리해 담당자에게 전달합니다. 연락처는 마지막 단계에서만 여쭙니다. Cloudia는 일본어와 영어로 응대합니다.',
    cta: 'Cloudia 열기',
  },
  es: {
    eyebrow: 'Contact with Cloudia',
    title: 'Empiece con una conversación con Cloudia',
    description:
      'Elija el motivo de su consulta y responda algunas preguntas. Cloudia organiza la información y la pasa a nuestro equipo. Solo le pedimos sus datos de contacto al final. Cloudia atiende en japonés e inglés.',
    cta: 'Abrir Cloudia',
  },
} as const satisfies Record<Locale, EntryCopy>;

const copy: EntryCopy = ENTRY_COPY[currentLocale];
const chatPath = `${chatUrl.pathname}${chatUrl.search}`;
---

<section class="mx-auto max-w-3xl px-4 pb-6 sm:px-6 lg:px-8" aria-labelledby="cloudia-contact-entry-title">
  <div class="overflow-hidden rounded-3xl bg-primary-950 px-6 py-8 text-primary-50 shadow-xl sm:px-8 sm:py-10 dark:bg-primary-100 dark:text-primary-950">
    <p class="text-sm font-medium uppercase tracking-[0.18em] text-primary-300 dark:text-primary-700">{copy.eyebrow}</p>
    <div class="mt-4 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-2xl">
        <h2 id="cloudia-contact-entry-title" class="type-heading text-2xl font-medium sm:text-3xl">{copy.title}</h2>
        <p class="type-copy mt-3 text-primary-200/80 dark:text-primary-800/80">{copy.description}</p>
      </div>
      <a
        href={chatPath}
        data-cloudia-query-link
        class="inline-flex min-h-[3rem] shrink-0 items-center justify-center rounded-full bg-primary-300 px-5 py-3 text-base font-semibold text-primary-950 transition hover:bg-primary-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-300 dark:bg-primary-700 dark:text-primary-50 dark:hover:bg-primary-800"
      >{copy.cta}</a>
    </div>
  </div>
</section>

{/* open 必須: 中身は所在地と打ち合わせ可能な時間帯。問い合わせ自体は Cloudia に一本化して
    いるが、会社の所在が初期状態で見えないのは信頼性を欠くため畳まない。
    以前ここに入っていたのはフォームだったため畳んでいたが、通常時フォームは出さない。 */}
<details id="contact-form-fallback" open class="mx-auto max-w-3xl px-4 pb-12 sm:px-6 lg:px-8">
  <summary class="cursor-pointer rounded-2xl bg-primary-500/10 px-5 py-4 text-base font-semibold text-primary-950 outline-none transition hover:bg-primary-500/15 focus-visible:ring-2 focus-visible:ring-primary-600 dark:bg-primary-400/10 dark:text-primary-100 dark:hover:bg-primary-400/15">
    {fallbackCopy.title}
  </summary>
  <p class="px-2 py-4 text-sm leading-6 text-primary-950/65 dark:text-primary-200/65">{fallbackCopy.description}</p>
  <div class="overflow-hidden rounded-3xl bg-primary-500/5 dark:bg-primary-400/5">
    <slot />
  </div>
</details>

<script is:inline>
  (() => {
    const incoming = new URLSearchParams(window.location.search);
    const intent = incoming.get('intent');
    const source = incoming.get('source');
    if (!intent && !source) return;

    document.querySelectorAll('[data-cloudia-query-link]').forEach((element) => {
      if (!(element instanceof HTMLAnchorElement)) return;
      const target = new URL(element.href, window.location.href);
      if (intent) target.searchParams.set('intent', intent);
      if (source) target.searchParams.set('source', source);
      element.href = `${target.pathname}${target.search}${target.hash}`;
    });
  })();
</script>

---
import { CONTACT_INTENTS } from '../../config/site';
import { getCurrentLocale, type Locale } from '../../utils/i18n';
import LbHeading from '../common/LbHeading.astro';
import LbText from '../common/LbText.astro';
import { CONTACT_SUPPORT_LABEL } from './contact-support-copy';

const currentLocale = getCurrentLocale(Astro.url);
const chatUrl = new URL('/contact/chat/', Astro.url);
chatUrl.searchParams.set('source', 'corsweb-contact-primary');
chatUrl.searchParams.set('locale', currentLocale);

type EntryCopy = { title: string; description: string; cta: string };
const ENTRY_COPY = {
  ja: {
    title: 'AIチャットで相談内容を伝える',
    description:
      'AI受付のCloudiaで、相談の目的を選び、質問にお答えください。最後に連絡先を入力して送信すると、相談内容を担当者に引き継ぎます。日本語と英語でご利用いただけます。',
    cta: 'AIチャットを開く',
  },
  en: {
    title: 'Start by contacting us',
    description:
      'Choose the purpose of your inquiry and answer a few questions. Cloudia organizes your inquiry and hands it to our team. We ask for your contact details only at the end. Cloudia supports Japanese and English.',
    cta: 'Start your inquiry',
  },
  zh: {
    title: '请先联系我们',
    description:
      '选择咨询目的并回答几个问题后，Cloudia 会整理内容并转交给负责人。联系方式只在最后一步填写。Cloudia 支持日语和英语。',
    cta: '开始联系',
  },
  ko: {
    title: '먼저 문의해 주세요',
    description:
      '문의 목적을 선택하고 몇 가지 질문에 답하시면 Cloudia가 내용을 정리해 담당자에게 전달합니다. 연락처는 마지막 단계에서만 여쭙니다. Cloudia는 일본어와 영어로 응대합니다.',
    cta: '문의 시작하기',
  },
  es: {
    title: 'Empiece contactándonos',
    description:
      'Elija el motivo de su consulta y responda algunas preguntas. Cloudia organiza la información y la pasa a nuestro equipo. Solo le pedimos sus datos de contacto al final. Cloudia atiende en japonés e inglés.',
    cta: 'Iniciar contacto',
  },
} as const satisfies Record<Locale, EntryCopy>;

const copy: EntryCopy = ENTRY_COPY[currentLocale];
const primaryLinkClass = 'inline-flex min-h-[48px] scroll-mb-24 items-center justify-center rounded-full bg-[#2d4a6b] px-6 py-3 text-center text-base font-semibold text-white transition hover:bg-[#1e3350] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2d4a6b] dark:bg-blue-200 dark:text-primary-950 dark:hover:bg-blue-100 dark:focus-visible:outline-blue-200 md:row-span-2 md:self-center';
const chatPath = `${chatUrl.pathname}${chatUrl.search}`;
---

<section class="mx-auto max-w-3xl px-4 pb-6 sm:px-6 lg:px-8 lg:max-w-content" data-contact-support-entry>
  <a href={chatPath} data-existing-customer-link class={primaryLinkClass}>{CONTACT_SUPPORT_LABEL[currentLocale]}</a>
</section>

<div hidden data-contact-intent-entry={CONTACT_INTENTS.join(' ')}>
  <section class="mx-auto max-w-3xl px-4 pb-6 sm:px-6 lg:px-8 lg:max-w-content" aria-labelledby="cloudia-contact-entry-title">
    <div class="rounded-2xl border border-primary-200 bg-primary-50 px-5 py-6 dark:border-primary-700 dark:bg-primary-950 sm:px-8 sm:py-8">
      <div class="grid items-start gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:gap-x-8">
        <LbHeading as="h2" id="cloudia-contact-entry-title" class="type-heading text-2xl font-semibold sm:text-3xl" text={copy.title} />
        <a
          href={chatPath}
          data-cloudia-query-link
          class={primaryLinkClass}
        >{copy.cta}</a>
        <LbText class="type-copy max-w-[40em] text-base leading-relaxed text-primary-950/80 dark:text-primary-200/80" text={copy.description} />
      </div>
    </div>
  </section>
</div>

<slot name="materials" />

<script is:inline data-astro-rerun>
  (() => {
    const incoming = new URLSearchParams(window.location.search);
    const intent = incoming.get('intent');
    const source = incoming.get('source');
    const purposeEntry = document.querySelector('[data-contact-intent-entry]');
    const supportEntry = document.querySelector('[data-contact-support-entry]');
    const link = purposeEntry?.querySelector('[data-cloudia-query-link]');
    if (!intent || !purposeEntry?.dataset.contactIntentEntry.split(' ').includes(intent) ||
        !supportEntry || !(link instanceof HTMLAnchorElement)) return;

    const target = new URL(link.href, window.location.href);
    target.searchParams.set('intent', intent);
    if (source) target.searchParams.set('source', source);
    link.href = `${target.pathname}${target.search}`;
    supportEntry.hidden = true;
    purposeEntry.hidden = false;
  })();
</script>

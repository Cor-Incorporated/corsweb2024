---
import { CONTACT_CALENDAR_VISIBLE } from '../../config/contact';
import { CONTACT_INTENTS, getGeneralConsultationUrl } from '../../config/site';
import { getCurrentLocale, type Locale } from '../../utils/i18n';
import LbHeading from '../common/LbHeading.astro';
import LbText from '../common/LbText.astro';

const currentLocale = getCurrentLocale(Astro.url);
const chatUrl = new URL('/contact/chat/', Astro.url);
chatUrl.searchParams.set('source', 'corsweb-contact-primary');
chatUrl.searchParams.set('locale', currentLocale);
const incomingIntent = Astro.url.searchParams.get('intent');
if (incomingIntent) chatUrl.searchParams.set('intent', incomingIntent);

// この <details> の中身は所在地と、（PUBLIC_GCAL_ID がある時だけ）代表スケジュールのカレンダー。
// 問い合わせは Cloudia に一本化した（ADR-0005 §6 撤回・2026-09-13）ため、ここを「代替の連絡先」と
// 名乗らせない。カレンダーが出ない環境では時間帯に触れない文言へ切り替え、中身と食い違わせない。
// この 2 つも下の ENTRY_COPY も全ロケール分を用意する
// （satisfies により、6言語目を足したときに翻訳漏れが型エラーになる）。
type FallbackCopy = { title: string; description: string };
const FALLBACK_WITH_CALENDAR = {
  ja: {
    title: '所在地・打ち合わせ可能な時間を見る',
    description:
      'お問い合わせはCloudia（AIチャット）で承っています。ここでは所在地と、打ち合わせ可能な時間帯をご確認いただけます。',
  },
  en: {
    title: 'Our location and available times',
    description:
      'Inquiries are handled through Cloudia, our AI chat. Here you can check our location and the times we are available to meet.',
  },
  zh: {
    title: '查看公司地址与可洽谈时间',
    description:
      '咨询请通过 AI 聊天助手 Cloudia 提出。此处可确认公司地址与可安排洽谈的时间段。',
  },
  ko: {
    title: '소재지·미팅 가능 시간 보기',
    description:
      '문의는 AI 챗봇 Cloudia에서 받고 있습니다. 여기에서는 소재지와 미팅이 가능한 시간대를 확인하실 수 있습니다.',
  },
  es: {
    title: 'Nuestra ubicación y horarios disponibles',
    description:
      'Las consultas se atienden a través de Cloudia, nuestro chat con IA. Aquí puede consultar nuestra ubicación y los horarios en que podemos reunirnos.',
  },
} as const satisfies Record<Locale, FallbackCopy>;

const FALLBACK_WITHOUT_CALENDAR = {
  ja: {
    title: '所在地を見る',
    description: 'お問い合わせはCloudia（AIチャット）で承っています。ここでは所在地をご確認いただけます。',
  },
  en: {
    title: 'Our location',
    description: 'Inquiries are handled through Cloudia, our AI chat. Here you can check our location.',
  },
  zh: {
    title: '查看公司地址',
    description: '咨询请通过 AI 聊天助手 Cloudia 提出。此处可确认公司地址。',
  },
  ko: {
    title: '소재지 보기',
    description: '문의는 AI 챗봇 Cloudia에서 받고 있습니다. 여기에서는 소재지를 확인하실 수 있습니다.',
  },
  es: {
    title: 'Nuestra ubicación',
    description: 'Las consultas se atienden a través de Cloudia, nuestro chat con IA. Aquí puede consultar nuestra ubicación.',
  },
} as const satisfies Record<Locale, FallbackCopy>;

const fallbackCopy: FallbackCopy = CONTACT_CALENDAR_VISIBLE
  ? FALLBACK_WITH_CALENDAR[currentLocale]
  : FALLBACK_WITHOUT_CALENDAR[currentLocale];

// 以前は ja/非ja の 2 分岐で、zh・ko・es のお問い合わせページに英語の案内が出ていた。
// 説明文は「開いた後に何が起きるか」を書く（目的を選ぶ → 質問に答える → 担当者へ引き継ぐ、
// 連絡先は最後だけ）。Cloudia 自体は日本語と英語だけなので、その旨は各言語で書く。
// 返信の目安（原則3営業日以内）はページの見出しの説明（contactPage）が書いているので、ここでは繰り返さない。
type EntryCopy = { title: string; description: string; cta: string };
const ENTRY_COPY = {
  ja: {
    title: 'AIチャットで相談内容を伝える',
    description:
      'AI受付のCloudiaで、相談の目的を選び、質問にお答えください。最後に連絡先を入力して送信すると、相談内容を担当者に引き継ぎます。日本語と英語でご利用いただけます。',
    cta: 'AIチャットを開く',
  },
  en: {
    title: 'Start by contacting us',
    description:
      'Choose the purpose of your inquiry and answer a few questions. Cloudia organizes your inquiry and hands it to our team. We ask for your contact details only at the end. Cloudia supports Japanese and English.',
    cta: 'Start your inquiry',
  },
  zh: {
    title: '请先联系我们',
    description:
      '选择咨询目的并回答几个问题后，Cloudia 会整理内容并转交给负责人。联系方式只在最后一步填写。Cloudia 支持日语和英语。',
    cta: '开始联系',
  },
  ko: {
    title: '먼저 문의해 주세요',
    description:
      '문의 목적을 선택하고 몇 가지 질문에 답하시면 Cloudia가 내용을 정리해 담당자에게 전달합니다. 연락처는 마지막 단계에서만 여쭙니다. Cloudia는 일본어와 영어로 응대합니다.',
    cta: '문의 시작하기',
  },
  es: {
    title: 'Empiece contactándonos',
    description:
      'Elija el motivo de su consulta y responda algunas preguntas. Cloudia organiza la información y la pasa a nuestro equipo. Solo le pedimos sus datos de contacto al final. Cloudia atiende en japonés e inglés.',
    cta: 'Iniciar contacto',
  },
} as const satisfies Record<Locale, EntryCopy>;

const INDUSTRY_ENTRY_COPY = {
  ja: {
    title: '業種を選んで相談する',
    description: '業種別のページで、相談できる内容をご確認いただけます。',
    cta: '業種を選ぶ',
    support: 'ご契約中のお客様のお問い合わせ',
  },
  en: {
    title: 'Find the right page for your industry',
    description: 'Your industry page explains what you can discuss with us.',
    cta: 'Choose your industry',
    support: 'Support for existing customers',
  },
  zh: {
    title: '按行业咨询',
    description: '请在行业页面查看可咨询的内容。',
    cta: '选择行业',
    support: '现有客户支持',
  },
  ko: {
    title: '업종별 문의',
    description: '업종별 페이지에서 상담할 수 있는 내용을 확인하세요.',
    cta: '업종 선택',
    support: '기존 고객 지원',
  },
  es: {
    title: 'Consultas por sector',
    description: 'En la página de su sector puede ver qué temas puede consultar.',
    cta: 'Elegir sector',
    support: 'Soporte para clientes actuales',
  },
} as const satisfies Record<Locale, EntryCopy & { support: string }>;

const copy: EntryCopy = ENTRY_COPY[currentLocale];
const industryCopy = INDUSTRY_ENTRY_COPY[currentLocale];
const primaryLinkClass = 'inline-flex min-h-[48px] scroll-mb-24 items-center justify-center rounded-full bg-[#2d4a6b] px-6 py-3 text-center text-base font-semibold text-white transition hover:bg-[#1e3350] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2d4a6b] dark:bg-blue-200 dark:text-primary-950 dark:hover:bg-blue-100 dark:focus-visible:outline-blue-200 md:row-span-2 md:self-center';
const chatPath = `${chatUrl.pathname}${chatUrl.search}`;
---

<section class="mx-auto max-w-3xl px-4 pb-6 sm:px-6 lg:px-8 lg:max-w-content" aria-labelledby="contact-industry-entry-title" data-contact-industry-entry>
  <div class="rounded-2xl border border-primary-200 bg-primary-50 px-5 py-6 dark:border-primary-700 dark:bg-primary-950 sm:px-8 sm:py-8">
    <div class="grid items-start gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:gap-x-8">
      <LbHeading as="h2" id="contact-industry-entry-title" class="type-heading text-2xl font-semibold sm:text-3xl" text={industryCopy.title} />
      <a href={getGeneralConsultationUrl(currentLocale, 'contact-industry')} data-contact-industry-link class={primaryLinkClass}>{industryCopy.cta}</a>
      <LbText class="type-copy max-w-[40em] text-base leading-relaxed text-primary-950/80 dark:text-primary-200/80" text={industryCopy.description} />
    </div>
  </div>
  <a href={chatPath} data-existing-customer-link class="mt-3 inline-flex min-h-[44px] items-center font-medium text-[#2d4a6b] underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 dark:text-blue-200">{industryCopy.support}</a>
</section>

<div hidden data-contact-intent-entry={CONTACT_INTENTS.join(' ')}>
  <section class="mx-auto max-w-3xl px-4 pb-6 sm:px-6 lg:px-8 lg:max-w-content" aria-labelledby="cloudia-contact-entry-title">
    <div class="rounded-2xl border border-primary-200 bg-primary-50 px-5 py-6 dark:border-primary-700 dark:bg-primary-950 sm:px-8 sm:py-8">
      <div class="grid items-start gap-4 md:grid-cols-[minmax(0,1fr)_auto] md:gap-x-8">
        <LbHeading as="h2" id="cloudia-contact-entry-title" class="type-heading text-2xl font-semibold sm:text-3xl" text={copy.title} />
        <a
          href={chatPath}
          data-cloudia-query-link
          class={primaryLinkClass}
        >{copy.cta}</a>
        <LbText class="type-copy max-w-[40em] text-base leading-relaxed text-primary-950/80 dark:text-primary-200/80" text={copy.description} />
      </div>
    </div>
  </section>
</div>

<slot name="materials" />

{/* open 必須: 中身は所在地と打ち合わせ可能な時間帯。問い合わせ自体は Cloudia に一本化して
    いるが、会社の所在が初期状態で見えないのは信頼性を欠くため畳まない。
    以前ここに入っていたのはフォームだったため畳んでいたが、通常時フォームは出さない。 */}
<details id="contact-form-fallback" open class="mx-auto max-w-3xl px-4 pb-12 sm:px-6 lg:px-8 lg:max-w-content">
  <summary class="cursor-pointer rounded-2xl bg-primary-500/10 px-5 py-4 text-base font-semibold text-primary-950 outline-none transition hover:bg-primary-500/15 focus-visible:ring-2 focus-visible:ring-primary-600 dark:bg-primary-400/10 dark:text-primary-100 dark:hover:bg-primary-400/15">
    {fallbackCopy.title}
  </summary>
  <LbText class="px-2 py-4 text-sm leading-6 text-primary-950/65 dark:text-primary-200/65" text={fallbackCopy.description} />
  <div class="overflow-hidden rounded-3xl bg-primary-500/5 dark:bg-primary-400/5">
    <slot />
  </div>
</details>

<script is:inline data-astro-rerun>
  (() => {
    const incoming = new URLSearchParams(window.location.search);
    const intent = incoming.get('intent');
    const source = incoming.get('source');
    const purposeEntry = document.querySelector('[data-contact-intent-entry]');
    const industryEntry = document.querySelector('[data-contact-industry-entry]');
    const link = purposeEntry?.querySelector('[data-cloudia-query-link]');
    if (!intent || !purposeEntry?.dataset.contactIntentEntry.split(' ').includes(intent) ||
        !industryEntry || !(link instanceof HTMLAnchorElement)) return;

    const target = new URL(link.href, window.location.href);
    target.searchParams.set('intent', intent);
    if (source) target.searchParams.set('source', source);
    link.href = `${target.pathname}${target.search}`;
    industryEntry.hidden = true;
    purposeEntry.hidden = false;
  })();
</script>

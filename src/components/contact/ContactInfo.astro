---
import { getCurrentLocale, getTranslations } from '../../utils/i18n';
import { CALL_CENTER_PHONE_VISIBLE, CALL_CENTER_TEL_HREF } from '../../config/contact';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
---

<section class="py-16 sm:py-20">
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <dl
      class:list={[
        'mx-auto grid max-w-3xl gap-6',
        // 電話カードを落とすと住所1枚になる。2カラムのままだと右半分が空くので1カラムに寄せる。
        CALL_CENTER_PHONE_VISIBLE && 'sm:grid-cols-2',
      ]}
    >
      {/* Address */}
      <div class="rounded-3xl bg-primary-500/10 px-6 py-8 dark:bg-primary-400/10">
        <dt class="sr-only">{t.contactInfo.address.label}</dt>
        {/* gap-12 から gap-6 に変更 */}
        <dd class="flex h-full flex-col justify-between gap-6">
          {/* h-6 w-6 から h-8 w-8 に変更 */}
          <svg
            class="h-8 w-8 text-primary-600 dark:text-primary-400"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 23.7279L5.63604 17.364C2.12132 13.8492 2.12132 8.15076 5.63604 4.63604C9.15076 1.12132 14.8492 1.12132 18.364 4.63604C21.8787 8.15076 21.8787 13.8492 18.364 17.364L12 23.7279ZM16.9497 15.9497C19.6834 13.2161 19.6834 8.78392 16.9497 6.05025C14.2161 3.31658 9.78392 3.31658 7.05025 6.05025C4.31658 8.78392 4.31658 13.2161 7.05025 15.9497L12 20.8995L16.9497 15.9497ZM12 13C10.8954 13 10 12.1046 10 11C10 9.89543 10.8954 9 12 9C13.1046 9 14 9.89543 14 11C14 12.1046 13.1046 13 12 13Z"
            ></path>
          </svg>
          <div class="text-base font-medium">
            <div class="text-base font-medium">
              <a href="https://maps.app.goo.gl/N9oa3j9ewUWqjs427"
                >{t.contactInfo.address.value}<br /></a
              >
            </div>
          </div>
        </dd>
      </div>

      {/* 電話（AI 自動応対のコールセンター）。
          以前はここに Cloudia への導線を置いていたが、ページ上部の CloudiaContactEntry に
          同じ導線があり二重になっていたため差し替えた。
          CALL_CENTER_PHONE_VISIBLE=false の間はカードごと出さない（番号だけ隠すと注記が浮くため）。 */}
      {
        CALL_CENTER_PHONE_VISIBLE && (
        <div class="rounded-3xl bg-primary-500/10 px-6 py-8 dark:bg-primary-400/10">
          <dt class="sr-only">{t.contactInfo.phone.label}</dt>
          <dd class="flex h-full flex-col justify-between gap-6">
            <svg
              class="h-8 w-8 text-primary-600 dark:text-primary-400"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path
                d="M21 16.42V19.9561C21 20.4811 20.5941 20.9167 20.0705 20.9537C19.6331 20.9846 19.2763 21 19 21C10.1634 21 3 13.8366 3 5C3 4.72371 3.01545 4.36687 3.04635 3.9295C3.08337 3.40588 3.51894 3 4.04386 3H7.5801C7.83678 3 8.05176 3.19442 8.07753 3.4498C8.10067 3.67907 8.12218 3.86314 8.14207 4.00203C8.34435 5.41407 8.75753 6.75378 9.34335 7.98216C9.4501 8.20602 9.38136 8.47426 9.1795 8.62205L7.02335 10.1614C8.33805 13.2138 10.7862 15.6619 13.8386 16.9766L15.3764 14.8241C15.5259 14.6218 15.7963 14.5525 16.0223 14.6602C17.2506 15.2452 18.5902 15.6584 20.0018 15.8607C20.1406 15.8806 20.3239 15.9019 20.5502 15.9251C20.8056 15.9508 21 16.1658 21 16.42Z"
              ></path>
            </svg>
            <div class="flex flex-col gap-2">
              <p class="text-sm font-medium text-primary-950/70 dark:text-primary-200/70">
                {t.contactInfo.phone.title}
              </p>
              {/* tel: リンク。スマホではタップで発信画面（確認あり）、PC では通話アプリの選択になる。
                  aria-describedby: リンク送りで移動する読み上げ利用者は周囲の <p> を読まないため、
                  これが無いと番号だけ聞いて発信し、AI が出て初めて気づくことになる（DOM 順に依らず解決する）。
                  min-h-[3rem](48px): タップして発信するのがこの機能の本体。ContactForm 等と同じ最小高に合わせる。 */}
              <a
                href={CALL_CENTER_TEL_HREF}
                aria-describedby="call-center-notice"
                class="inline-flex min-h-[3rem] items-center text-base font-medium no-underline hover:underline"
              >
                {t.contactInfo.phone.value}
              </a>
              {/* AI が応対する旨は発信前に伝える必要がある（掛けてから気づく体験を避ける）。 */}
              <p id="call-center-notice" class="text-sm leading-6 text-primary-950/65 dark:text-primary-200/65">
                {t.contactInfo.phone.notice}
              </p>
            </div>
          </dd>
        </div>
        )
      }
    </dl>
  </div>
</section>

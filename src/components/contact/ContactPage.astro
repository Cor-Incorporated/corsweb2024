---
import Calendar from './Calendar.astro';
import ContactChat from './ContactChat.astro';
import ContactForm from './ContactForm.astro';
import ContactInfo from './ContactInfo.astro';
import LegacyContactEntry from './LegacyContactEntry.astro';
import DocumentRequestEntry from './DocumentRequestEntry.astro';
import Heading from './Heading.astro';
import Layout from '../../layouts/Layout.astro';
import { CLOUDIA_CONTACT_PRIMARY_ENABLED, CLOUDIA_LAUNCHER_ENABLED, CONTACT_CHAT_ENABLED } from '../../config/contact';
import { getCurrentLocale, getTranslations } from '../../utils/i18n';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
const legacy = CLOUDIA_CONTACT_PRIMARY_ENABLED && !CONTACT_CHAT_ENABLED;
---

{!CONTACT_CHAT_ENABLED && !CLOUDIA_CONTACT_PRIMARY_ENABLED && (
  <script src="https://www.google.com/recaptcha/api.js" async defer is:inline></script>
)}

<Layout description={t.meta.contact.description} title={t.meta.contact.title}>
  {legacy ? (
    <LegacyContactEntry />
  ) : (
    <>
      <div class="lb-heading-balance">
        <Heading />
      </div>
      {CONTACT_CHAT_ENABLED ? (
        <ContactChat />
      ) : (
        <section id="contact-form-fallback" data-cloudia-fallback={CLOUDIA_LAUNCHER_ENABLED ? 'true' : 'false'}>
          <ContactInfo />
          <Calendar />
          <ContactForm />
        </section>
      )}
      <DocumentRequestEntry />
    </>
  )}
</Layout>

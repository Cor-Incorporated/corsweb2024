---
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../../utils/i18n';

const locale = getCurrentLocale(Astro.url);
const copy = getTranslations(locale).documentRequest;
const href = getLocalizedUrl('/contact/materials/', locale);
---

<p class="mx-auto max-w-3xl px-4 pt-10 text-base text-primary-950 dark:text-primary-200 sm:px-6">
  <a class="underline" href={href}>{copy.entryLabel}</a>
  <span class="mt-1 block text-sm text-primary-950/70 dark:text-primary-200/70">{copy.entryNote}</span>
</p>

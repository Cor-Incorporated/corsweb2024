---
import { getCurrentLocale, getTranslations, type Locale } from '../../utils/i18n';
import {
  CALL_CENTER_TEL_HREF,
  CLOUDIA_GRIFT_HANDOFF_ALLOWED_ORIGINS,
  CLOUDIA_GRIFT_HANDOFF_MAX_TTL_MS,
} from '../../config/contact';
import { industryContactSource, industrySlugFromPath } from '../../config/industry-context';
import { CLOUDIA_UNAVAILABLE_PHONE_VISIBLE } from './chat/cloudiaUnavailableCopy';
import { buildUnavailableNotice } from './chat/cloudiaUnavailableNotice';

const currentLocale = getCurrentLocale(Astro.url);
const industrySlug = industrySlugFromPath(Astro.url.pathname);
const chatUrl = new URL('/contact/chat/', Astro.url);
chatUrl.searchParams.set('source', industrySlug ? industryContactSource(industrySlug) : 'corsweb-launcher');
chatUrl.searchParams.set('locale', currentLocale);
const incomingIntent = Astro.url.searchParams.get('intent');
if (incomingIntent) chatUrl.searchParams.set('intent', incomingIntent);
const embedChatUrl = new URL(chatUrl);
embedChatUrl.searchParams.set('embed', '1');
const embedChatPath = `${embedChatUrl.pathname}${embedChatUrl.search}`;
// 枠の中だけ開けないときの逃げ道は、/contact/ ではなく単独の /contact/chat/（embed なし）。
// /contact/ の主ボタンも同じ /contact/chat/ を開くので、/contact/ へ戻すと 2 回押させるうえ、
// Cloudia 自体が配られないときは同じ所を回る（#352）。単独のページには浮きボタンが出ないので、自分への link にもならない。
const separateChatUrl = new URL('/contact/chat/', Astro.url);
separateChatUrl.searchParams.set(
  'source',
  Astro.url.searchParams.get('source') ||
    (industrySlug ? industryContactSource(industrySlug) : 'corsweb-launcher-fallback')
);
separateChatUrl.searchParams.set('locale', currentLocale);
if (incomingIntent) separateChatUrl.searchParams.set('intent', incomingIntent);
const separateChatHref = `${separateChatUrl.pathname}${separateChatUrl.search}`;
// 電話の行は定数の後ろ（既定は出さない）。番号は既存の定義から読み、ここに書かない。
const unavailablePhone = {
  display: getTranslations(currentLocale).contactInfo.phone.value,
  href: CALL_CENTER_TEL_HREF,
};
const frameFailedNotice = buildUnavailableNotice({
  kind: 'frame-failed',
  locale: currentLocale,
  phoneVisible: CLOUDIA_UNAVAILABLE_PHONE_VISIBLE,
  phone: unavailablePhone,
  separateHref: separateChatHref,
});
const unavailableNotice = buildUnavailableNotice({
  kind: 'unavailable',
  locale: currentLocale,
  phoneVisible: CLOUDIA_UNAVAILABLE_PHONE_VISIBLE,
  phone: unavailablePhone,
});
// 以前は ja/非ja の 2 分岐で、zh・ko・es のページでは英語のボタンが出ていた。
// satisfies により、6 言語目を足したときに翻訳漏れが型エラーになる。
type LauncherCopy = {
  label: string;
  title: string;
  close: string;
  // 開いている間の右下のボタンの文言。× ボタン（close）と同じ名前にすると、読み上げで 2 つの「閉じる」が並ぶ。
  closeLauncher: string;
};
const LAUNCHER_COPY = {
  ja: {
    label: 'Cloudiaに相談する',
    title: 'Cloudiaに相談する',
    close: '閉じる',
    closeLauncher: 'Cloudiaを閉じる',
    // Cloudia が開けないときの文は ./chat/cloudiaUnavailableCopy.ts に置く（代わりのページと contact-edge と共通）。
  },
  en: {
    label: 'Chat with Cloudia',
    title: 'Chat with Cloudia',
    close: 'Close',
    closeLauncher: 'Close Cloudia',
  },
  zh: {
    label: '咨询 Cloudia',
    title: '咨询 Cloudia',
    close: '关闭',
    closeLauncher: '关闭 Cloudia',
  },
  ko: {
    label: 'Cloudia에게 상담하기',
    title: 'Cloudia에게 상담하기',
    close: '닫기',
    closeLauncher: 'Cloudia 닫기',
  },
  es: {
    label: 'Consultar con Cloudia',
    title: 'Consultar con Cloudia',
    close: 'Cerrar',
    closeLauncher: 'Cerrar Cloudia',
  },
} as const satisfies Record<Locale, LauncherCopy>;

const copy: LauncherCopy = LAUNCHER_COPY[currentLocale];
---

<aside
  id="cloudia-launcher"
  class="pointer-events-none fixed bottom-[calc(1rem+env(safe-area-inset-bottom))] right-4 z-40 flex w-max max-w-[calc(100vw-2rem)] flex-col items-end sm:right-5"
  data-chat-path={embedChatPath}
  data-grift-handoff-origins={JSON.stringify(CLOUDIA_GRIFT_HANDOFF_ALLOWED_ORIGINS)}
  data-grift-handoff-max-ttl-ms={CLOUDIA_GRIFT_HANDOFF_MAX_TTL_MS}
  data-unavailable-message={unavailableNotice.message}
>
  <div
    id="cloudia-launcher-panel"
    class="pointer-events-auto ring-primary-950/15 dark:ring-primary-200/15 mb-3 hidden w-[min(24rem,calc(100vw-2rem))] overflow-hidden rounded-2xl bg-primary-50 shadow-2xl ring-1 dark:bg-primary-950"
    aria-hidden="true"
  >
    <div
      class="flex items-center justify-between gap-3 border-b border-primary-950/10 px-4 py-3 dark:border-primary-200/10"
    >
      <h2 class="text-sm font-semibold text-primary-950 dark:text-primary-100">{copy.title}</h2>
      <button
        type="button"
        id="cloudia-launcher-close"
        class="min-h-9 min-w-9 inline-flex items-center justify-center rounded-full text-primary-950/70 hover:bg-primary-500/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:text-primary-200/70 dark:hover:bg-primary-400/10"
        aria-label={copy.close}
      >
        <span aria-hidden="true" class="text-xl leading-none">×</span>
      </button>
    </div>
    <div class="relative h-[min(38rem,70dvh)] max-h-[70dvh] bg-primary-950/5 dark:bg-primary-50/5">
      <iframe
        id="cloudia-launcher-frame"
        title={copy.title}
        src={embedChatPath}
        class="h-full w-full border-0"
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"></iframe>
      <div
        id="cloudia-launcher-fallback"
        class="absolute inset-0 flex hidden flex-col items-center justify-center gap-3 bg-primary-50 px-6 text-center dark:bg-primary-950"
        role="status"
        aria-live="polite"
      >
        <p data-cloudia-fallback-message class="text-sm leading-relaxed text-primary-950/75 dark:text-primary-200/75">
          {frameFailedNotice.message}
        </p>
        {
          frameFailedNotice.separate && (
            <a
              href={frameFailedNotice.separate.href}
              data-cloudia-fallback-link
              class="min-h-11 inline-flex items-center justify-center rounded-full bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:bg-primary-400 dark:text-primary-950 dark:hover:bg-primary-300"
            >
              {frameFailedNotice.separate.label}
            </a>
          )
        }
        {
          frameFailedNotice.phone && (
            <p data-cloudia-fallback-phone class="text-sm leading-relaxed text-primary-950/75 dark:text-primary-200/75">
              {frameFailedNotice.phone.lead}
              <br />
              {frameFailedNotice.phone.label}:{' '}
              <a href={frameFailedNotice.phone.href} class="font-semibold underline underline-offset-2">
                {frameFailedNotice.phone.display}
              </a>
            </p>
          )
        }
      </div>
    </div>
  </div>
  <button
    type="button"
    id="cloudia-launcher-open"
    class="pointer-events-auto min-h-[3rem] inline-flex items-center justify-center rounded-full bg-primary-600 px-5 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 hover:bg-primary-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:bg-primary-400 dark:text-primary-950 dark:hover:bg-primary-300"
    aria-expanded="false"
    aria-controls="cloudia-launcher-panel"
    data-label-open={copy.label}
    data-label-close={copy.closeLauncher}
  >
    {copy.label}
  </button>
</aside>

<script is:inline>
  // ViewTransitions ではページ遷移で body（＝このランチャー）ごと DOM が差し替わるが、is:inline
  // スクリプトは初回しか実行されない。関数化して astro:page-load（初回＋遷移後に必ず発火）で
  // 毎回束縛し直さないと、サイト内リンクで移動した後にボタンが無反応になる（#307・CEO 報告）。
  function initCloudiaLauncher() {
    const launcher = document.getElementById('cloudia-launcher');
    const openButton = document.getElementById('cloudia-launcher-open');
    const closeButton = document.getElementById('cloudia-launcher-close');
    const panel = document.getElementById('cloudia-launcher-panel');
    const frame = document.getElementById('cloudia-launcher-frame');
    const fallback = document.getElementById('cloudia-launcher-fallback');
    const linkElement = launcher?.querySelector('[data-cloudia-fallback-link]');
    if (!launcher || !openButton || !closeButton || !panel || !frame || !fallback) return;
    let fallbackLink = linkElement instanceof HTMLAnchorElement ? linkElement : null;

    // 初期化は 1 つの要素につき 1 回だけ。/contact/chat/ のプレースホルダ（ランチャーなし）を経て戻ると、
    // ViewTransitions がこのスクリプトをもう一度実行し、astro:page-load の受け手が 2 つになる。
    // 2 つの受け手が同じボタンに開閉を付けると、それぞれの opened がずれて、開いてすぐ閉じることがある。
    // 遷移のたびに body（＝ランチャー）は新しい要素になるので、要素に印を付けて二重の束縛だけを防ぐ。
    if (launcher.dataset.cloudiaBound === 'true') return;
    launcher.dataset.cloudiaBound = 'true';

    let opened = false;
    let frameReady = false;
    let handoffNavigationStarted = false;
    let fallbackTimer;

    const allowedHandoffOrigins = (() => {
      try {
        const values = JSON.parse(launcher.dataset.griftHandoffOrigins || '[]');
        return Array.isArray(values)
          ? new Set(values.filter((value) => typeof value === 'string'))
          : new Set();
      } catch {
        return new Set();
      }
    })();
    const handoffMaxTtlMs = Number(launcher.dataset.griftHandoffMaxTtlMs);

    const applyIncomingContext = () => {
      const incoming = new URLSearchParams(window.location.search);
      const intent = incoming.get('intent');
      const source = incoming.get('source');
      if (!intent && !source) return;
      const target = new URL(frame.src, window.location.href);
      if (intent) target.searchParams.set('intent', intent);
      if (source) target.searchParams.set('source', source);
      frame.src = target.toString();
      launcher.dataset.chatPath = `${target.pathname}${target.search}`;
      if (!fallbackLink) return;
      const fallbackTarget = new URL(fallbackLink.href, window.location.href);
      if (intent) fallbackTarget.searchParams.set('intent', intent);
      if (source) fallbackTarget.searchParams.set('source', source);
      fallbackLink.href = `${fallbackTarget.pathname}${fallbackTarget.search}${fallbackTarget.hash}`;
    };

    applyIncomingContext();

    const fallbackMessage = fallback.querySelector('[data-cloudia-fallback-message]');
    // 末尾スラッシュを揃えて比較する。サイト内のリンクは /contact（スラッシュ無し）が大半で、
    // ViewTransitions で遷移すると location.pathname も /contact になる。
    // /contact/index.html のような明示的なインデックス表記も同じページとして扱う。
    const normalizePath = (path) => {
      const withoutIndex = path.replace(/\/index\.html$/, '/');
      return withoutIndex.length > 1 ? withoutIndex.replace(/\/+$/, '') : withoutIndex;
    };

    // 受け付けられないと分かったら、別の画面への link を消し、終わりの文に替える。
    // 電話の行（定数で出すときだけ在る）は残す。同じ壊れた画面へ戻す link を残さない。
    const switchToUnavailable = () => {
      fallbackLink?.remove();
      fallbackLink = null;
      const text = launcher.dataset.unavailableMessage;
      // 同じ文を書き直さない（見えている間に書くと、読み上げが同じ文をくり返す）。
      if (fallbackMessage && text && fallbackMessage.textContent !== text) fallbackMessage.textContent = text;
    };
    // 見えない（display:none）間に入った文は、画面読み上げによっては読まれない。見せた後、次の描画で文を入れ直し、
    // 変化として読ませる。jsdom（build の出力の試験）には requestAnimationFrame が無いので、setTimeout で代える。
    const nextFrame = window.requestAnimationFrame
      ? (callback) => window.requestAnimationFrame(callback)
      : (callback) => window.setTimeout(callback, 0);
    // 入れ直すのは、逃げ道とパネルの両方が見えているときだけ。パネルが閉じている間（時間切れの timer は閉じても
    // 止まらない）に入れ直しても読まれないので、開いたときに入れ直す（openPanel）。
    const reinsertFallbackMessage = () => {
      nextFrame(() => {
        if (!fallbackMessage || fallback.classList.contains('hidden') || panel.classList.contains('hidden')) return;
        fallbackMessage.replaceChildren(document.createTextNode(fallbackMessage.textContent ?? ''));
      });
    };
    const revealFallback = () => {
      // 既に見えているなら何もしない。入れ直すのは、見えない状態から見せる 1 回だけ。
      if (!fallback.classList.contains('hidden')) return;
      fallback.classList.remove('hidden');
      reinsertFallbackMessage();
    };
    const showUnavailable = () => {
      if (frameReady) return;
      switchToUnavailable();
      revealFallback();
    };

    // 逃げ道の link が今のページを指すなら、従えない指示になる。始めから終わりの文にしておく。
    if (
      fallbackLink &&
      normalizePath(new URL(fallbackLink.href, window.location.href).pathname) ===
        normalizePath(window.location.pathname)
    ) {
      switchToUnavailable();
    }

    // 「開けた」は、Cloudia が描いたこと（#root に子の要素が在る）か、cloudia:ready の合図で決める。
    // #root が在るだけでは決めない（HTML は来たが script が落ちると、空の枠のまま止まる）。
    // 合図を送らない版の Cloudia でも、描かれれば #root に子の要素ができるので、配備の前でも後でも動く。
    let notCloudia = false; // 読み込まれたが Cloudia ではない（代わりのページ・別のページへの戻し・止める応答）
    let rootEmpty = false; // Cloudia の HTML は来たが、まだ描かれていない
    const markReady = () => {
      frameReady = true;
      window.clearTimeout(fallbackTimer);
      fallback.classList.add('hidden');
    };
    const readFrame = () => {
      try {
        const frameWindow = frame.contentWindow;
        const frameDocument = frame.contentDocument;
        if (!frameWindow || !frameDocument || frameWindow.location.href === 'about:blank') return 'pending';
        const root = frameDocument.getElementById('root');
        if (root && root.firstElementChild) return 'ready';
        if (frameDocument.readyState !== 'complete') return 'pending';
        if (!root || !normalizePath(frameWindow.location.pathname).startsWith('/contact/chat')) {
          return 'not-cloudia';
        }
        return 'empty';
      } catch {
        // 別の origin やエラーのページは読めない。時間切れで「枠だけ開けない」と判定する。
        return 'opaque';
      }
    };
    const inspectFrame = () => {
      if (frameReady) return;
      const state = readFrame();
      if (state === 'ready') {
        markReady();
        return;
      }
      if (state === 'not-cloudia') {
        notCloudia = true;
        showUnavailable();
        return;
      }
      rootEmpty = state === 'empty';
      if (opened) window.setTimeout(inspectFrame, 250);
    };
    const onFallbackTimeout = () => {
      if (frameReady) return;
      if (notCloudia || rootEmpty) {
        showUnavailable();
        return;
      }
      revealFallback();
    };

    // 開いている間もボタンが「Cloudiaに相談する」のままだと、もう一度押したら何が起きるか分からない
    // （スマホではパネルのすぐ下に残る）。開いている間は「Cloudiaを閉じる」と表示し、押せば閉じる。
    const setOpenButtonLabel = (isOpen) => {
      const label = isOpen ? openButton.dataset.labelClose : openButton.dataset.labelOpen;
      if (label) openButton.textContent = label;
    };

    const openPanel = () => {
      opened = true;
      panel.classList.remove('hidden');
      panel.setAttribute('aria-hidden', 'false');
      openButton.setAttribute('aria-expanded', 'true');
      setOpenButtonLabel(true);
      closeButton.focus();
      // 閉じている間に逃げ道が出ていたら、開いた次の描画で 1 回だけ入れ直して読ませる。
      if (!fallback.classList.contains('hidden')) reinsertFallbackMessage();
      window.clearTimeout(fallbackTimer);
      fallbackTimer = window.setTimeout(onFallbackTimeout, 8000);
      inspectFrame();
    };

    const closePanel = () => {
      opened = false;
      panel.classList.add('hidden');
      panel.setAttribute('aria-hidden', 'true');
      openButton.setAttribute('aria-expanded', 'false');
      setOpenButtonLabel(false);
      openButton.focus();
    };

    const parseHandoffUrl = (value) => {
      if (typeof value !== 'string' || !value.trim() || value.length > 2048) return null;
      try {
        const url = new URL(value.trim());
        if (!allowedHandoffOrigins.has(url.origin)) return null;
        if (url.protocol !== 'https:' || url.username || url.password) return null;
        if (!/^\/chat\/portal\/[A-Za-z0-9._~-]{1,512}$/.test(url.pathname)) return null;
        if (url.search || url.hash) return null;
        return url.toString();
      } catch {
        return null;
      }
    };

    const hasValidHandoffExpiry = (value) => {
      if (typeof value !== 'string' || !Number.isFinite(handoffMaxTtlMs) || handoffMaxTtlMs <= 0)
        return false;
      const expiresAt = Date.parse(value);
      if (!Number.isFinite(expiresAt)) return false;
      const remainingTtl = expiresAt - Date.now();
      return remainingTtl > 0 && remainingTtl <= handoffMaxTtlMs;
    };

    // open/close/frame は遷移のたびに新しい要素になるので、毎回この要素に束縛する。
    openButton.addEventListener('click', () => (opened ? closePanel() : openPanel()));
    closeButton.addEventListener('click', closePanel);
    frame.addEventListener('load', inspectFrame);

    // keydown / message は window/document に付くため遷移で破棄されない。前回のハンドラを外して
    // から現在のクロージャ（現在の frame / state を参照）で付け直す。これをしないと遷移ごとに
    // ハンドラが累積し、古い frame を掴んだハンドラが残る。
    if (window.__cloudiaKeydownHandler) {
      document.removeEventListener('keydown', window.__cloudiaKeydownHandler);
    }
    window.__cloudiaKeydownHandler = (event) => {
      if (opened && event.key === 'Escape') closePanel();
    };
    document.addEventListener('keydown', window.__cloudiaKeydownHandler);

    if (window.__cloudiaMessageHandler) {
      window.removeEventListener('message', window.__cloudiaMessageHandler);
    }
    window.__cloudiaMessageHandler = (event) => {
      if (event.source !== frame.contentWindow || event.origin !== window.location.origin) return;
      if (event.data === 'cloudia:ready') {
        markReady();
        return;
      }
      if (
        handoffNavigationStarted ||
        !event.data ||
        typeof event.data !== 'object' ||
        event.data.type !== 'cloudia:grift-handoff-ready' ||
        !hasValidHandoffExpiry(event.data.expiresAt)
      )
        return;

      const handoffUrl = parseHandoffUrl(event.data.url);
      if (!handoffUrl) return;
      handoffNavigationStarted = true;
      window.location.assign(handoffUrl);
    };
    window.addEventListener('message', window.__cloudiaMessageHandler);
  }

  // astro:page-load は初回ロードと ViewTransitions の各遷移後に必ず発火する。
  document.addEventListener('astro:page-load', initCloudiaLauncher);
</script>

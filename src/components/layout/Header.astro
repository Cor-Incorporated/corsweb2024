---
import { getCurrentLocale, getTranslations, getLocalizedUrl, type Locale } from '../../utils/i18n';
import { getContactUrl, getGriftUrl } from '../../config/site';

// このページが存在するロケール。言語切替が「同一ページの翻訳版」へ飛ぶか、翻訳が無い言語で
// ホームへフォールバックするかの判定に使う。未指定なら全言語ありとみなす（従来の暗黙の挙動）。
interface Props {
  availableLocales?: readonly Locale[];
}
const { availableLocales = ['ja', 'en', 'zh', 'ko', 'es'] } = Astro.props;

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
// nav 拡張キー（未翻訳言語向けフォールバック）
const nav = t.nav as typeof t.nav & {
  services?: string;
  serviceAssessment?: string;
  serviceLocalLlm?: string;
  serviceAiDev?: string;
  industries?: string;
  consult?: string;
  press?: string;
};

// サービス導線（ADR-0011）: LP 未整備のため intent 付き /contact と Grift
const serviceLinks = [
  {
    name: nav.serviceAssessment || '機密データAI活用診断',
    href: getContactUrl(currentLocale, {
      intent: 'confidential-ai-assessment',
      source: 'header',
    }),
    isExternal: false,
  },
  {
    name: nav.serviceLocalLlm || 'ローカルLLM / セキュアAI PoC',
    href: getContactUrl(currentLocale, {
      intent: 'local-llm-poc',
      source: 'header',
    }),
    isExternal: false,
  },
  {
    name: nav.serviceAiDev || 'AI基盤構築・AI受託',
    href: getContactUrl(currentLocale, {
      intent: 'contract-dev',
      source: 'header-ai-dev',
    }),
    isExternal: false,
  },
  {
    name: nav.grift,
    href: getGriftUrl('/', { intent: 'grift-team-beta', source: 'header' }),
    isExternal: true,
  },
];

// /works・/news・/news/press は [lang] ルートで全言語に存在する（#313）。/industries も同様。
const baseLinks = [
  { name: t.nav.home, href: getLocalizedUrl('/', currentLocale), isExternal: false },
  { name: t.nav.works, href: getLocalizedUrl('/works', currentLocale), isExternal: false },
  { name: t.nav.news, href: getLocalizedUrl('/news', currentLocale), isExternal: false },
  { name: nav.press || 'プレスリリース', href: getLocalizedUrl('/news/press', currentLocale), isExternal: false },
  {
    name: nav.industries || '業種別',
    href: getLocalizedUrl('/industries/medical', currentLocale),
    isExternal: false,
  },
  { name: t.nav.security, href: getLocalizedUrl('/security', currentLocale), isExternal: false },
  { name: t.nav.about, href: getLocalizedUrl('/about', currentLocale), isExternal: false },
  { name: t.nav.blog, href: getLocalizedUrl('/blog', currentLocale), isExternal: false },
  {
    name: nav.consult || t.nav.contact,
    href: getContactUrl(currentLocale, { source: 'header' }),
    isExternal: false,
  },
];
// 現在地ハイライト判定: Astro.url.pathname と各リンクの href を比較。
// 末尾スラッシュの揺れを吸収するため正規化してから比較する。トップ(/)も対象。
// ロジックは全言語共通。外部リンク(Grift 等)は判定対象外。
const normalizePath = (path: string) => {
  if (!path) return '/';
  // query を除いて比較
  const withoutQuery = path.split('?')[0] || '/';
  const trimmed = withoutQuery.replace(/\/+$/, '');
  return trimmed === '' ? '/' : trimmed;
};
const currentPath = normalizePath(Astro.url.pathname);

const links = baseLinks.map((link, index) => ({
  ...link,
  ref: String(index + 1).padStart(2, '0'),
  isActive: !link.isExternal && normalizePath(link.href) === currentPath,
}));

const isCurrentSection = (href: string) => {
  const normalizedHref = normalizePath(href);
  return currentPath === normalizedHref || (normalizedHref !== '/' && currentPath.startsWith(`${normalizedHref}/`));
};

const quickLinks = [
  { name: t.nav.works, href: getLocalizedUrl('/works', currentLocale) },
  { name: t.nav.news, href: getLocalizedUrl('/news', currentLocale) },
  { name: nav.press || 'プレスリリース', href: getLocalizedUrl('/news/press', currentLocale) },
  { name: t.nav.security, href: getLocalizedUrl('/security', currentLocale) },
  {
    name: nav.consult || t.nav.contact,
    href: getContactUrl(currentLocale, { source: 'header-quick' }),
  },
].map((link) => ({
  ...link,
  isActive: isCurrentSection(link.href),
}));

const servicesLabel = nav.services || 'サービス';

// 言語切替（プルダウン）: 各言語の遷移先URLを現在パスから算出し、一覧から直接選べるようにする。
const localeOrder = ['ja', 'en', 'zh', 'ko', 'es'] as const;
const langNames: Record<string, string> = {
  ja: '日本語',
  en: 'English',
  zh: '中文',
  ko: '한국어',
  es: 'Español',
};
const langFlags: Record<string, string> = {
  ja: '🇯🇵',
  en: '🇺🇸',
  zh: '🇨🇳',
  ko: '🇰🇷',
  es: '🇪🇸',
};
// 現在パスから locale プレフィックスを除いた基準パス（例: /en/about → /about）。
const langBasePath = Astro.url.pathname.replace(/^\/(en|zh|ko|es)(?=\/|$)/, '') || '/';
const langOptions = localeOrder.map((loc) => ({
  loc,
  name: langNames[loc],
  flag: langFlags[loc],
  // このページが対象言語に存在すれば「同一ページの翻訳版」へ、無ければその言語のホームへ
  // （404回避）。従来は非ja を一律ホームに飛ばしていたため、翻訳済みページでも言語切替で
  // トップに戻される不具合があった（CEO 報告 #307）。availableLocales で正しく出し分ける。
  href: availableLocales.includes(loc) ? getLocalizedUrl(langBasePath, loc) : `/${loc}`,
  isCurrent: loc === currentLocale,
}));
---

<header
  x-data="{ open: false, servicesOpen: false }"
  class="relative z-40 bg-primary-50 transition dark:bg-primary-950"
  :class="{ 'bg-primary-500/10 dark:bg-primary-400/10': open, 'bg-primary-50 dark:bg-primary-950': !(open) }"
>
  <div
    class="mx-auto flex max-w-2xl items-center justify-between px-4 py-4 sm:px-6 sm:py-6 lg:max-w-7xl lg:px-8"
  >
    <!-- Brand logo -->
    <div class="flex">
      <a
        href={getLocalizedUrl('/', currentLocale)}
        class="rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-950 dark:group-focus-visible:outline-primary-200"
      >
        <span class="sr-only">Cor.株式会社</span>
        <img class="h-20 w-auto" width="65" height="40" src="/assets/logo.avif" alt="Cor.株式会社" />
      </a>
    </div>

    <nav class="hidden min-w-0 flex-1 items-center justify-center gap-1 lg:flex" aria-label="主要ページ">
      {/* サービス ドロップダウン（診断 / PoC / 受託 / Grift） */}
      <div
        class="relative"
        @keydown.escape="servicesOpen = false"
        @click.outside="servicesOpen = false"
      >
        <button
          type="button"
          @click="servicesOpen = !servicesOpen"
          aria-expanded="false"
          :aria-expanded="servicesOpen.toString()"
          aria-haspopup="true"
          class="inline-flex items-center gap-1 rounded-full px-2.5 py-2 text-sm font-medium text-primary-950 transition hover:bg-primary-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-950 dark:text-primary-200 dark:hover:bg-primary-400/10 dark:focus-visible:ring-primary-200 xl:px-4"
        >
          {servicesLabel}
          <svg
            class="h-4 w-4 transition"
            :class="{ 'rotate-180': servicesOpen }"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 15L7 10H17L12 15Z"></path>
          </svg>
        </button>
        <ul
          x-cloak
          x-show="servicesOpen"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 -translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-1"
          class="absolute left-1/2 z-50 mt-2 w-72 -translate-x-1/2 overflow-hidden rounded-2xl border border-primary-900/10 bg-primary-50 py-1 shadow-lg dark:border-primary-300/10 dark:bg-primary-950"
        >
          {
            serviceLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.isExternal ? '_blank' : undefined}
                  rel={link.isExternal ? 'noopener noreferrer' : undefined}
                  class="flex items-center px-4 py-3 text-sm font-medium text-primary-950 transition hover:bg-primary-500/10 dark:text-primary-200 dark:hover:bg-primary-400/10"
                >
                  {link.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      {
        quickLinks.map((link) => (
          <a
            href={link.href}
            aria-current={link.isActive ? 'page' : undefined}
            class:list={[
              'rounded-full px-2.5 py-2 text-sm font-medium transition hover:bg-primary-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-950 dark:hover:bg-primary-400/10 dark:focus-visible:ring-primary-200 xl:px-4',
              link.isActive
                ? 'bg-primary-500/10 text-[#2d4a6b] dark:bg-primary-400/10 dark:text-primary-100'
                : 'text-primary-950 dark:text-primary-200',
            ]}
          >
            {link.name}
          </a>
        ))
      }
    </nav>

    <!-- Actions -->
    <div class="-mr-2 flex items-center space-x-2 sm:space-x-3">
      <!-- Theme toggle: 一般的なスイッチ式（ノブが現在モードのアイコンを表示してスライド） -->
      <button
        type="button"
        x-data
        role="switch"
        data-theme-switch
        aria-checked="false"
        :aria-checked="($store.theme?.isDark || false).toString()"
        @click="$store.theme?.toggle()"
        class="relative inline-flex h-8 w-14 shrink-0 items-center rounded-full border border-primary-900/10 bg-primary-500/10 transition focus:outline-none focus-visible:ring-2 ring-primary-950 dark:border-primary-300/10 dark:bg-primary-400/10"
      >
        <span class="sr-only">ライト / ダークモード切り替え</span>
        <span
          class="inline-flex h-6 w-6 translate-x-1 transform items-center justify-center rounded-full bg-primary-50 text-primary-950 shadow transition-transform dark:translate-x-7 dark:bg-primary-200"
          :class="{ 'translate-x-7': $store.theme?.isDark, 'translate-x-1': !($store.theme?.isDark) }"
        >
          <!-- Moon (dark時)。Alpine 起動前も dark: バリアントで正しい方を出す -->
          <svg
            class="hidden h-4 w-4 dark:block"
            :class="{ 'hidden': !($store.theme?.isDark) }"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M10 6C10 10.4183 13.5817 14 18 14C19.4386 14 20.7885 13.6203 21.9549 12.9556C21.4738 18.0302 17.2005 22 12 22C6.47715 22 2 17.5228 2 12C2 6.79948 5.9698 2.52616 11.0444 2.04507C10.3797 3.21152 10 4.56142 10 6ZM4 12C4 16.4183 7.58172 20 12 20C14.9654 20 17.5757 18.3788 18.9571 15.9546C18.6407 15.9848 18.3214 16 18 16C12.4772 16 8 11.5228 8 6C8 5.67863 8.01524 5.35933 8.04536 5.04293C5.62119 6.42426 4 9.03458 4 12Z"
            ></path>
          </svg>
          <!-- Sun (light時) -->
          <svg
            class="h-4 w-4 dark:hidden"
            :class="{ 'hidden': $store.theme?.isDark }"
            xmlns="http://www.w3.org/2000/svg"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M12 18C8.68629 18 6 15.3137 6 12C6 8.68629 8.68629 6 12 6C15.3137 6 18 8.68629 18 12C18 15.3137 15.3137 18 12 18ZM12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16ZM11 1H13V4H11V1ZM11 20H13V23H11V20ZM3.51472 4.92893L4.92893 3.51472L7.05025 5.63604L5.63604 7.05025L3.51472 4.92893ZM16.9497 18.364L18.364 16.9497L20.4853 19.0711L19.0711 20.4853L16.9497 18.364ZM19.0711 3.51472L20.4853 4.92893L18.364 7.05025L16.9497 5.63604L19.0711 3.51472ZM5.63604 16.9497L7.05025 18.364L4.92893 20.4853L3.51472 19.0711L5.63604 16.9497ZM23 11V13H20V11H23ZM4 11V13H1V11H4Z"
            ></path>
          </svg>
        </span>
      </button>
      <!-- Language switch (プルダウン: 5言語を一覧から直接選択) -->
      <div
        class="relative"
        x-data="{ langOpen: false }"
        @keydown.escape="langOpen = false"
        @click.outside="langOpen = false"
      >
        <button
          type="button"
          @click="langOpen = !langOpen"
          aria-expanded="false"
          :aria-expanded="langOpen.toString()"
          aria-haspopup="true"
          class="inline-flex h-14 items-center justify-center gap-1.5 rounded-full px-4 text-primary-950 ring-primary-950 transition hover:bg-primary-500/10 focus:outline-none focus-visible:ring-2 dark:text-primary-200 dark:hover:bg-primary-400/10"
        >
          <span class="sr-only">言語を切り替え / Language</span>
          <span class="text-2xl leading-none">{langFlags[currentLocale]}</span>
          <svg
            class="h-4 w-4 transition"
            :class="{ 'rotate-180': langOpen }"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M12 15L7 10H17L12 15Z"></path>
          </svg>
        </button>
        <ul
          x-cloak
          x-show="langOpen"
          x-transition:enter="transition ease-out duration-150"
          x-transition:enter-start="opacity-0 -translate-y-1"
          x-transition:enter-end="opacity-100 translate-y-0"
          x-transition:leave="transition ease-in duration-100"
          x-transition:leave-start="opacity-100 translate-y-0"
          x-transition:leave-end="opacity-0 -translate-y-1"
          aria-label="Language"
          class="absolute right-0 z-50 mt-2 w-44 overflow-hidden rounded-2xl border border-primary-900/10 bg-primary-50 py-1 shadow-lg dark:border-primary-300/10 dark:bg-primary-950"
        >
          {
            langOptions.map((o) => (
              <li>
                <a
                  href={o.href}
                  hreflang={o.loc}
                  aria-current={o.isCurrent ? 'true' : undefined}
                  class:list={[
                    'flex items-center gap-3 px-4 py-3 text-base transition hover:bg-primary-500/10 dark:hover:bg-primary-400/10',
                    o.isCurrent
                      ? 'font-semibold text-[#2d4a6b] dark:text-primary-100'
                      : 'text-primary-950 dark:text-primary-200',
                  ]}
                >
                  <span class="text-xl leading-none">{o.flag}</span>
                  <span class="flex-1">{o.name}</span>
                  {o.isCurrent && (
                    <svg
                      class="h-4 w-4 text-[#2d4a6b] dark:text-primary-100"
                      xmlns="http://www.w3.org/2000/svg"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M9.55 18L3.85 12.3L5.275 10.875L9.55 15.15L18.725 5.975L20.15 7.4L9.55 18Z" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <!-- Toggle menu -->
      <button
        type="button"
        class="inline-flex h-14 w-14 items-center justify-center rounded-full text-primary-950 ring-primary-950 transition hover:bg-primary-500/10 focus:outline-none focus-visible:ring-2 dark:text-primary-200 dark:hover:bg-primary-400/10"
        @click="open = !open"
        @mousedown="if (open) $event.preventDefault()"
        aria-controls="website-menu"
        aria-expanded="false"
        :aria-expanded="open.toString()"
      >
        <span class="sr-only">Toggle menu</span>
        <svg
          class="block h-8 w-8"
          :class="{ 'hidden': open, 'block': !(open) }"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M19 8H5V10H19V8ZM19 14H5V16H19V14Z"></path>
        </svg>
        <svg
          class="hidden h-8 w-8"
          :class="{ 'block': open, 'hidden': !(open) }"
          xmlns="http://www.w3.org/2000/svg"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M12.0007 10.5865L16.9504 5.63672L18.3646 7.05093L13.4149 12.0007L18.3646 16.9504L16.9504 18.3646L12.0007 13.4149L7.05093 18.3646L5.63672 16.9504L10.5865 12.0007L5.63672 7.05093L7.05093 5.63672L12.0007 10.5865Z"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menu content -->
  <div
    class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8 overflow-hidden transition-all"
    id="website-menu"
    x-cloak
    x-show="open"
    x-transition:enter="transition ease-out duration-500"
    x-transition:enter-start="opacity-0 transform scale-95"
    x-transition:enter-end="opacity-100 transform scale-100"
    x-transition:leave="transition ease-in duration-300"
    x-transition:leave-start="opacity-100 transform scale-100"
    x-transition:leave-end="opacity-0 transform scale-95"
  >
    <div class="grid grid-cols-1 gap-16 pb-24 pt-6 lg:grid-cols-2 lg:pt-12">
      <div
        class="hidden items-center justify-center rounded-3xl bg-primary-500/10 px-6 py-8 dark:bg-primary-400/10 lg:flex"
      >
        <p
          class="max-w-sm text-xl italic leading-loose text-primary-950/70 dark:text-primary-200/70"
        >
          {t.header.mobileMenuDescription}
        </p>
      </div>

      <!-- Navigation -->
      <nav class="flex flex-col gap-1 divide-y divide-primary-900/10 dark:divide-primary-300/10">
        {
          links.map((link) => (
            <a
              href={link.href}
              target={link.isExternal ? '_blank' : undefined}
              rel={link.isExternal ? 'noopener noreferrer' : undefined}
              class="group inline-flex py-6 text-3xl font-medium tracking-tight text-primary-950 transition focus-visible:outline-none dark:text-primary-200 sm:py-8 sm:text-4xl"
            >
              <div class="flex flex-1 items-center justify-between rounded-3xl group-focus-visible:outline group-focus-visible:outline-2 group-focus-visible:outline-offset-2 group-focus-visible:outline-primary-950 dark:group-focus-visible:outline-primary-200">
                <div class="flex items-center gap-6">
                  <span class="text-xs">{link.ref}</span>
                  <span
                    class:list={['group-hover:underline', { 'font-semibold text-[#2d4a6b]': link.isActive }]}
                    aria-current={link.isActive ? 'page' : undefined}
                  >
                    {link.name}
                  </span>
                </div>
                <svg
                  class="h-6 w-6 text-primary-600 dark:text-primary-400 sm:h-8 sm:w-8"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                </svg>
              </div>
            </a>
          ))
        }
        {/* サービス（モバイル: フラット展開） */}
        <div class="py-6 sm:py-8">
          <p class="mb-4 text-xs font-medium uppercase tracking-widest text-primary-600 dark:text-primary-400">
            {servicesLabel}
          </p>
          <ul class="flex flex-col gap-3">
            {
              serviceLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    target={link.isExternal ? '_blank' : undefined}
                    rel={link.isExternal ? 'noopener noreferrer' : undefined}
                    class="inline-flex min-h-[44px] items-center text-xl font-medium tracking-tight text-primary-950 underline-offset-4 transition hover:underline dark:text-primary-200 sm:text-2xl"
                  >
                    {link.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>
  </div>
</header>

---
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../../utils/i18n';
import Fukuoka100Emblem from '../common/Fukuoka100Emblem.astro';
import { COMPANY_SOCIAL_LINKS } from '../../config/organization';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);

const bottomLinks = [
  {
    header: t.footer.social,
    // 会社の公式アカウント。正本は config/organization.ts（Organization JSON-LD の sameAs と共有）。
    links: COMPANY_SOCIAL_LINKS.map((link) => ({ ...link, isExternal: true })),
  },
  {
    header: t.footer.company,
    links: [
      {
        name: t.footer.links.home,
        href: getLocalizedUrl('/', currentLocale),
        isExternal: false,
      },
      {
        name: t.footer.links.about,
        href: getLocalizedUrl('/about', currentLocale),
        isExternal: false,
      },
      // /works と /news は [lang] ルートで全言語に存在する（#313）。
      {
        name: t.nav.works,
        href: getLocalizedUrl('/works', currentLocale),
        isExternal: false,
      },
      {
        name: t.footer.links.news,
        href: getLocalizedUrl('/news', currentLocale),
        isExternal: false,
      },
      {
        name: t.footer.links.contact,
        href: getLocalizedUrl('/contact', currentLocale),
        isExternal: false,
      },
    ],
  },
  {
    header: t.footer.legal,
    links: [
      {
        name: t.footer.links.security,
        href: getLocalizedUrl('/security', currentLocale),
        isExternal: false,
      },
      {
        name: t.footer.links.privacy,
        href: getLocalizedUrl('/privacy', currentLocale),
        isExternal: false,
      },
      {
        name: t.footer.links.legal,
        href: getLocalizedUrl('/legal/tokushoho', currentLocale),
        isExternal: false,
      },
    ],
  },
];

// 現在地ハイライト判定: Header と同じく Astro.url.pathname と各リンクの href を
// 正規化して比較する。末尾スラッシュの揺れを吸収。外部リンク(GitHub 等)は対象外。
const normalizePath = (path: string) => {
  if (!path) return '/';
  const trimmed = path.replace(/\/+$/, '');
  return trimmed === '' ? '/' : trimmed;
};
const currentPath = normalizePath(Astro.url.pathname);

type FooterLink = { name: string; href: string; isExternal: boolean };

const linkGroups = bottomLinks.map((group) => ({
  ...group,
  links: group.links.map((link: FooterLink) => ({
    ...link,
    isActive: !link.isExternal && normalizePath(link.href) === currentPath,
  })),
}));
---

<footer
  class="mt-16 bg-primary-500/10 py-16 dark:bg-primary-400/10 lg:mt-20 lg:py-20"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">{t.footer.title}</h2>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col justify-between gap-12 sm:gap-16 lg:flex-row">
      <div class="flex max-w-sm flex-col items-start gap-6 sm:gap-8">
        <img
          class="h-20 w-auto"
          width="65"
          height="40"
          :src="'/assets/logo.avif'"
          alt="Cor.株式会社"
          loading="lazy"
        />
        <p class="px-5 text-base leading-[1.8] text-primary-950/70 dark:text-primary-200/70 sm:px-0">
          {t.footer.description}
        </p>
        {/* 福岡を代表する企業100選 公式エンブレム（#304）。フッターは全ページに出るため、トップ以外
            （ブログ・実績・セキュリティ等）から流入した人にも届く。掲載条件（クリック遷移・2027年
            7月末の掲載期限）はコンポーネント側で担保しているため、ここでは配置とサイズのみ。 */}
        <Fukuoka100Emblem imgClass="h-16 w-auto" class="px-5 sm:px-0" />
        {/* 年は SSG(output:static) のためビルド時評価で焼き込まれる。年初の定期再ビルド、または #44(SSR化) 後のリクエスト時評価で自動更新される。 */}
        <p class="text-sm text-primary-950/70 dark:text-primary-200/70">© {new Date().getFullYear()} {t.footer.copyright}</p>
      </div>

      <!-- Bottom links -->
      <div class="grid max-w-xl flex-1 grid-cols-1 gap-8 sm:grid-cols-3">
        {
          linkGroups.map((group) => (
            <div class="flex flex-col gap-4">
              <p class="text-base font-medium">{group.header}</p>
              <ul role="list" class="flex flex-col gap-3">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class:list={[
                        'inline-flex items-center gap-1 rounded-md text-base hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-950 dark:focus-visible:outline-primary-200',
                        { 'font-semibold text-[#2d4a6b] dark:text-primary-100': link.isActive },
                      ]}
                      aria-current={link.isActive ? 'page' : undefined}
                      target={link.isExternal ? '_blank' : undefined}
                      rel={link.isExternal ? 'noopener' : undefined}
                    >
                      {link.name}
                      {link.isExternal && (
                        <svg
                          class="h-4 w-4"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z" />
                        </svg>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</footer>

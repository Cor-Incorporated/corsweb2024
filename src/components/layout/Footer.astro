---
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../../utils/i18n';
import Fukuoka100Emblem from '../common/Fukuoka100Emblem.astro';
import { getContactCalendarUrl, getGeneralConsultationUrl } from '../../config/site';
import { CONTACT_CALENDAR_VISIBLE } from '../../config/contact';
import { ORGANIZATION_NAMES, SOCIAL_LINKS } from '../../config/organization';
import { SERVICE_PAGES, getServiceUrl } from '../../config/services';
import { CURRENT_SITE, SITE_CHROME, commonLinksFor, siteChromeYear } from '../../config/site-chrome';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
// 一番下の行（共通の帯）の中身。link とサイト切替の URL の正本は src/config/site-chrome.json。
const chromeLinks = commonLinksFor(currentLocale);
const chromeSites = SITE_CHROME.sites;

const bottomLinks = [
  {
    header: t.footer.social,
    // 正本は config/organization.ts。会社の公式アカウントだけが Organization JSON-LD の sameAs にも入る。
    links: SOCIAL_LINKS.map(({ name, href }) => ({ name, href, isExternal: true })),
  },
  // サービスのページ（ADR-0024）。正本は config/services.ts（ヘッダーの「サービス」と同じ並び）
  {
    header: t.nav.services,
    links: SERVICE_PAGES.map((page) => ({
      name: t.nav[page.key],
      href: getServiceUrl(page, currentLocale),
      isExternal: false,
    })),
  },
  {
    header: t.footer.company,
    links: [
      {
        name: t.footer.links.home,
        href: getLocalizedUrl('/', currentLocale),
        isExternal: false,
      },
      {
        name: t.footer.links.about,
        href: getLocalizedUrl('/about', currentLocale),
        isExternal: false,
      },
      // 会社概要（所在地・設立・代表者・事業の柱）。全言語にページがある。
      {
        name: t.footer.links.company,
        href: getLocalizedUrl('/company', currentLocale),
        isExternal: false,
      },
      // /works と /news は [lang] ルートで全言語に存在する（#313）。
      {
        name: t.nav.works,
        href: getLocalizedUrl('/works', currentLocale),
        isExternal: false,
      },
      {
        name: t.footer.links.news,
        href: getLocalizedUrl('/news', currentLocale),
        isExternal: false,
      },
      // 共通の相談リンクは、その言語の業種一覧を開く。
      {
        name: t.footer.links.contact,
        href: getGeneralConsultationUrl(currentLocale, 'footer'),
        isExternal: false,
      },
      // 問い合わせページのカレンダーの区画（代表の公開スケジュール）へ直接向ける 1 本。
      // カレンダーは PUBLIC_GCAL_ID がある build にだけ在るので、その時だけ描く（無いのに時間を言わない）。
      ...(CONTACT_CALENDAR_VISIBLE
        ? [{ name: t.footer.links.calendar, href: getContactCalendarUrl(currentLocale), isExternal: false }]
        : []),
    ],
  },
  {
    header: t.footer.legal,
    links: [
      {
        name: t.footer.links.security,
        href: getLocalizedUrl('/security', currentLocale),
        isExternal: false,
      },
      {
        name: t.footer.links.privacy,
        href: getLocalizedUrl('/privacy', currentLocale),
        isExternal: false,
      },
      {
        name: t.footer.links.legal,
        href: getLocalizedUrl('/legal/tokushoho', currentLocale),
        isExternal: false,
      },
    ],
  },
];

// 現在地ハイライト判定: Header と同じく Astro.url.pathname と各リンクの href を
// 正規化して比較する。末尾スラッシュの揺れを吸収。外部リンク(GitHub 等)は対象外。
const normalizePath = (path: string) => {
  if (!path) return '/';
  const trimmed = path.replace(/\/+$/, '');
  return trimmed === '' ? '/' : trimmed;
};
const currentPath = normalizePath(Astro.url.pathname);

type FooterLink = { name: string; href: string; isExternal: boolean };

const linkGroups = bottomLinks.map((group) => ({
  ...group,
  links: group.links.map((link: FooterLink) => ({
    ...link,
    isActive: !link.isExternal && normalizePath(link.href) === currentPath,
  })),
}));
---

<footer
  class="mt-16 bg-primary-500/10 py-16 dark:bg-primary-400/10 lg:mt-20 lg:py-20"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">{t.footer.title}</h2>
  <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-7xl lg:px-8">
    <div class="flex flex-col justify-between gap-12 sm:gap-16 lg:flex-row">
      <div class="flex max-w-sm flex-col items-start gap-6 sm:gap-8">
        <img
          class="h-20 w-auto"
          width="65"
          height="40"
          src="/assets/logo.avif"
          alt="Cor.株式会社"
          loading="lazy"
        />
        <p class="px-5 text-base leading-[1.8] text-primary-950/70 dark:text-primary-200/70 sm:px-0">
          {t.footer.description}
        </p>
        {/* 福岡を代表する企業100選 公式エンブレム（#304）。フッターは全ページに出るため、トップ以外
            （ブログ・実績・セキュリティ等）から流入した人にも届く。掲載条件（クリック遷移・2027年
            7月末の掲載期限）はコンポーネント側で担保しているため、ここでは配置とサイズのみ。 */}
        <Fukuoka100Emblem imgClass="h-16 w-auto" class="px-5 sm:px-0" />
      </div>

      <!-- Bottom links -->
      <!-- 列は 4 つ（Social / サービス / Company / Legal）。サービス名が長いので、横に 4 列並べるのは xl から -->
      <div class="grid max-w-3xl flex-1 grid-cols-1 gap-8 sm:grid-cols-2 xl:grid-cols-4">
        {
          linkGroups.map((group) => (
            <div class="flex flex-col gap-4">
              <p class="text-base font-medium">{group.header}</p>
              <ul role="list" class="flex flex-col gap-3">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class:list={[
                        'inline-flex items-center gap-1 rounded-md text-base hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-950 dark:focus-visible:outline-primary-200',
                        { 'font-semibold text-[#2d4a6b] dark:text-primary-100': link.isActive },
                      ]}
                      aria-current={link.isActive ? 'page' : undefined}
                      target={link.isExternal ? '_blank' : undefined}
                      rel={link.isExternal ? 'noopener' : undefined}
                    >
                      {link.name}
                      {link.isExternal && (
                        <svg
                          class="h-4 w-4"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          fill="currentColor"
                          aria-hidden="true"
                        >
                          <path d="M10 6V8H5V19H16V14H18V20C18 20.5523 17.5523 21 17 21H4C3.44772 21 3 20.5523 3 20V7C3 6.44772 3.44772 6 4 6H10ZM21 3V11H19L18.9999 6.413L11.2071 14.2071L9.79289 12.7929L17.5849 5H13V3H21Z" />
                        </svg>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {/* 一番下の行を 3 サイト共通の帯に置き換えた（© の行はここへ移動）。ページの contentinfo は
      この <footer> 1 つなので、帯は <div> にする。1024px 以上の高さは 64px（上の border 1px を含む）。
      年は SSG のためビルド時評価で焼き込まれる（年初の定期再ビルドで更新）。
      会社名は各言語の正式な社名（ORGANIZATION_NAMES）。 */}
  <div class="border-t border-primary-900/10 text-[13px] dark:border-primary-300/10 lg:h-16">
    <div
      class="mx-auto flex max-w-2xl flex-col items-start gap-2.5 px-3 py-4 sm:px-6 lg:h-full lg:max-w-7xl lg:flex-row lg:items-center lg:gap-6 lg:px-6 lg:py-0"
    >
      <p class="whitespace-nowrap text-primary-600 dark:text-primary-400">
        © {siteChromeYear()} {ORGANIZATION_NAMES[currentLocale]}
      </p>
      <nav
        aria-label={t.footer.commonLinksLabel}
        class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-2.5 lg:flex-1 lg:justify-center lg:gap-x-6"
      >
        {
          chromeLinks.map((link) => (
            <a
              href={link.href}
              rel="noopener"
              class="inline-flex min-h-[1.5rem] items-center rounded-md text-primary-950 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-950 dark:text-primary-200 dark:focus-visible:outline-primary-200"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      {/* data-site-switch: この nav の中の link だけがサイト切替（contact-links の除外もこの属性で絞る） */}
      <nav aria-label={t.footer.sitesLabel} data-site-switch class="flex items-center gap-3.5 lg:gap-4">
        {
          chromeSites.map((site) => (
            <a
              href={site.href}
              rel="noopener"
              aria-current={site.id === CURRENT_SITE ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-[1.5rem] items-center rounded-md hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary-950 dark:focus-visible:outline-primary-200',
                site.id === CURRENT_SITE
                  ? 'font-bold text-primary-950 dark:text-primary-200'
                  : 'text-primary-600 dark:text-primary-400',
              ]}
            >
              {site.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

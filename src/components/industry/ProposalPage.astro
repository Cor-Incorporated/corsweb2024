---
// 業種の提案ページ（#525 の本文とその訳）。ja の 5 ページ（src/pages/industries/*.astro）と、
// PROPOSAL_LOCALES（proposal-locales.ts）に在る言語の [lang]/industries/[industry].astro が使う。
// 並び: 導入（H1、問い合わせボタン、導入の文） → 本文 → サービスへの道（IndustryPaths, #509）→ 問い合わせ → 参考資料。
// 文言はその言語の locale の industry<Name>.proposal、リンク先は proposal-links.ts。
// 形は proposal-schema.ts で検証する。
import type { IndustrySlug } from '../../config/industry-context';
import { industryContactSource } from '../../config/industry-context';
import { getCurrentLocale, getTranslations } from '../../utils/i18n';
import IndustryPaths from './IndustryPaths.astro';
import ProposalBlocks from './ProposalBlocks.astro';
import ProposalHeading from './ProposalHeading.astro';
import ProposalInline from './ProposalInline.astro';
import ProposalSources from './ProposalSources.astro';
import { DOCUMENT_DOWNLOAD_HREF, PROPOSAL_LINKS, industryInquiryHref } from './proposal-links';
import { isProposalLocale } from './proposal-locales';
import { assertProposalLinks, proposalPageSchema } from './proposal-schema';

interface Props {
  industry: IndustrySlug;
}

const PAGE_KEYS = {
  medical: 'industryMedical',
  shigyo: 'industryShigyo',
  construction: 'industryConstruction',
  manufacturing: 'industryManufacturing',
  education: 'industryEducation',
} as const satisfies Record<IndustrySlug, string>;

const { industry } = Astro.props;
const locale = getCurrentLocale(Astro.url);
if (!isProposalLocale(locale)) {
  throw new Error(`ProposalPage は PROPOSAL_LOCALES の言語だけで使う（${locale} の ${industry} で呼ばれた）`);
}
const page = proposalPageSchema.parse(getTranslations(locale)[PAGE_KEYS[industry]].proposal);
assertProposalLinks(page, PROPOSAL_LINKS[industry], `${locale}/${PAGE_KEYS[industry]}`);
const inquiryHref = industryInquiryHref(locale, industry);
const inquiryClass = 'inline-flex min-h-[48px] w-full max-w-sm scroll-mb-28 items-center justify-center rounded-full bg-[#2d4a6b] px-6 py-3 text-center text-base font-semibold text-white transition hover:bg-[#1e3350] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2d4a6b] dark:bg-blue-200 dark:text-primary-950 dark:hover:bg-blue-100 dark:focus-visible:outline-blue-200 sm:w-auto';
// 資料ダウンロードの段落と副ボタンは、資料の受け取りの入口（DOCUMENT_DOWNLOAD_HREF）ができるまで出さない。
const downloadHref = DOCUMENT_DOWNLOAD_HREF;
const ctaParagraphs = page.cta.body.flatMap((block) => {
  if ('p' in block) return [block.p];
  if ('downloadNote' in block && downloadHref) return [block.downloadNote];
  return [];
});
---

<section class="pb-10 pt-12 sm:pb-14 sm:pt-20" data-proposal-hero>
  <div class="mx-auto max-w-reading px-4 sm:px-6 lg:px-8">
    <p class="text-sm font-medium uppercase tracking-widest text-primary-600 dark:text-primary-400">
      {page.eyebrow}
    </p>
    <ProposalHeading as="h1" text={page.title} class="mt-4 text-3xl font-semibold leading-tight sm:text-5xl" />
    <div class="mt-6 sm:mt-8">
      <a
        href={inquiryHref}
        class={inquiryClass}
        data-industry-inquiry={industryContactSource(industry)}
      >
        {page.cta.primary}
      </a>
    </div>
    <div class="mt-6 sm:mt-8">
      <ProposalBlocks blocks={page.lead} industry={industry} page={page} />
    </div>
  </div>
</section>

<div class="pb-16 sm:pb-24" data-proposal-body>
  <div class="mx-auto max-w-reading px-4 sm:px-6 lg:px-8">
    <ProposalBlocks blocks={page.sections} industry={industry} page={page} />
  </div>
</div>

<IndustryPaths industry={industry} />

<section class="py-16 sm:py-24">
  <div class="mx-auto max-w-reading px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-5 rounded-2xl border border-primary-200 bg-primary-50 px-5 py-8 dark:border-primary-700 dark:bg-primary-950 sm:px-10 sm:py-12" data-proposal-cta>
      <ProposalHeading as="h2" text={page.cta.title} class="text-2xl font-semibold sm:text-3xl" />
      {
        ctaParagraphs.map((paragraph) => (
          <p class="text-pretty text-base leading-relaxed text-primary-950/80 dark:text-primary-200/80 sm:text-lg"><ProposalInline value={paragraph} industry={industry} mode="sentences" /></p>
        ))
      }
      <a
        href={inquiryHref}
        class={inquiryClass}
        data-industry-inquiry={industryContactSource(industry)}
      >
        {page.cta.primary}
      </a>
      {
        downloadHref && (
          <a
            href={downloadHref}
            class="inline-flex min-h-[48px] w-full max-w-sm scroll-mb-28 items-center justify-center rounded-full border border-primary-300 px-5 py-3 text-center text-base font-medium transition hover:bg-primary-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 dark:border-primary-600 dark:hover:bg-primary-900 sm:w-auto"
            data-document-download
          >
            {page.cta.downloadButton}
          </a>
        )
      }
    </div>
  </div>
</section>

<ProposalSources industry={industry} page={page} />

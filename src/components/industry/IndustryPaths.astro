---
import { getCollection } from 'astro:content';
import { INDUSTRY_NAMED_CASE, industryContactSource, industryRowsInOrder, type IndustrySlug } from '../../config/industry-context';
import { SERVICE_PAGES, getServiceUrl } from '../../config/services';
import { localizeEntries, toCleanSlug } from '../../utils/content-i18n';
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../../utils/i18n';

interface Props {
  industry: IndustrySlug;
}

const { industry } = Astro.props;
const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
const common = t.servicePages.common;
const source = industryContactSource(industry);

const services = SERVICE_PAGES.map((page) => ({
  href: getServiceUrl(page, currentLocale),
  name: t.nav[page.key],
}));

const namedCaseSlug = INDUSTRY_NAMED_CASE[industry];
const namedCase = namedCaseSlug
  ? localizeEntries(
      await getCollection('cases', ({ data }) => import.meta.env.DEV || !data.isDraft),
      currentLocale,
    ).find((entry) => toCleanSlug(entry.slug) === namedCaseSlug)
  : undefined;
if (namedCaseSlug && !namedCase) {
  throw new Error(`業種 ${industry} の関連実績「${namedCaseSlug}」が無い`);
}

// 「業種別」の見出しの下に、今の業種を除いたほかの業種への link を並べる（0 件なら見出しごと出さない）。
const otherIndustries = industryRowsInOrder(t.homeIndustries.rows, `${currentLocale}.homeIndustries`).filter(
  (row) => row.slug !== industry,
);
---

<nav class="pb-4 sm:pb-8" aria-label={t.nav.services} data-industry-paths={source}>
  <div class="mx-auto flex max-w-reading flex-col gap-8 px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-4">
      <h2 class="text-2xl font-medium tracking-tight sm:text-3xl">{t.nav.services}</h2>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {
          services.map((service) => (
            <li class="min-w-0 rounded-3xl bg-primary-500/10 dark:bg-primary-400/10">
              <a
                href={service.href}
                class="flex min-h-12 scroll-mb-28 items-center break-words px-4 py-3 text-base font-medium text-primary-950 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:text-primary-50"
              >
                {service.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    {
      namedCase && (
        <div class="flex flex-col gap-4">
          <h2 class="text-2xl font-medium tracking-tight sm:text-3xl">{common.relatedWorksTitle}</h2>
          <a
            href={getLocalizedUrl(`/works/${namedCaseSlug}`, currentLocale)}
            class="inline-flex min-h-12 scroll-mb-28 items-center break-words text-base font-medium text-primary-950 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:text-primary-50"
          >
            {namedCase.data.title}
          </a>
        </div>
      )
    }
    {
      otherIndustries.length > 0 && (
        <div class="flex flex-col gap-4" data-other-industries>
          <h2 class="text-2xl font-medium tracking-tight sm:text-3xl">{t.nav.industries}</h2>
          <ul class="flex flex-wrap gap-2">
            {otherIndustries.map((row) => (
              <li>
                <a
                  href={getLocalizedUrl(row.link, currentLocale)}
                  class="inline-flex min-h-12 scroll-mb-28 items-center rounded-full bg-primary-500/10 px-4 text-base font-medium text-primary-950 underline-offset-4 hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:bg-primary-400/10 dark:text-primary-50"
                >
                  {row.industry}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</nav>

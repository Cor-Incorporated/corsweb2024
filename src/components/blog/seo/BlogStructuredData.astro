---
// ブログ記事の構造化データ (JSON-LD): Article / BreadcrumbList / WebSite / Organization。
// 生成ロジックは utils/blog-structured-data.ts と utils/structured-data.ts（vitest で検証）。
// Organization ノードをこのページにも出し、Article の publisher / copyrightHolder の @id 参照を解決させる。
import type { Locale } from '../../../utils/i18n';
import { safeJsonLd } from '../../../utils/json-ld';
import { buildBlogArticleJsonLd, buildBlogBreadcrumbJsonLd } from '../../../utils/blog-structured-data';
import { buildOrganizationJsonLd, buildWebSiteJsonLd } from '../../../utils/structured-data';

interface Props {
  title: string;
  description: string;
  keywords: string;
  author: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  // CollectionEntry 由来では url/alt が optional 推論になるため緩めに受ける
  image?: { url?: string; alt?: string };
  // 本文から数えた語数（ja / zh は文字数）。本文が無いページでは undefined。
  wordCount?: number;
  currentLocale: Locale;
}

const { currentLocale, ...article } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const articleJsonLd = buildBlogArticleJsonLd({ ...article, locale: currentLocale, pageUrl });
const breadcrumbJsonLd = buildBlogBreadcrumbJsonLd(currentLocale, article.title);
const websiteJsonLd = buildWebSiteJsonLd(currentLocale);
const organizationJsonLd = buildOrganizationJsonLd(currentLocale);
---

<script type="application/ld+json" is:inline set:html={safeJsonLd(articleJsonLd)} />
<script type="application/ld+json" is:inline set:html={safeJsonLd(breadcrumbJsonLd)} />
<script type="application/ld+json" is:inline set:html={safeJsonLd(websiteJsonLd)} />
<script type="application/ld+json" is:inline set:html={safeJsonLd(organizationJsonLd)} />

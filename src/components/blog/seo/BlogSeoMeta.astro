---
// ブログ記事の基本SEOメタタグ: description/keywords/canonical/RSS/article:*/hreflang。
// hreflang は実在する翻訳だけ（utils/blog-structured-data.ts の buildBlogHreflang で生成）。
import { getRobotsContent } from '../../../config/site';
import type { HreflangLink } from '../../../utils/blog-structured-data';

interface Props {
  description: string;
  keywords: string;
  author: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags: string[];
  hreflangLinks: HreflangLink[];
}

const { description, keywords, author, pubDate, updatedDate, category, tags, hreflangLinks } = Astro.props;

const robotsContent = getRobotsContent();
---

<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={author} />
<meta name="robots" content={robotsContent} />
<meta name="revisit-after" content="7 days" />
<meta name="format-detection" content="telephone=no" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

<!-- RSS Feeds -->
<link rel="alternate" type="application/rss+xml" title="Cor.inc 技術ブログ (日本語)" href="/rss.xml" />
<link rel="alternate" type="application/rss+xml" title="Cor.inc Tech Blog (English)" href="/en/rss.xml" />

<!-- Article specific meta tags -->
<meta property="article:published_time" content={pubDate.toISOString()} />
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
<meta property="article:author" content={author} />
<meta property="article:section" content={category} />
{tags.map(tag => <meta property="article:tag" content={tag} />)}

<!-- Hreflang: 実在する言語版のみ + x-default（どの言語版からも同じ集合を出して相互参照を保つ） -->
{hreflangLinks.map((link) => <link rel="alternate" href={link.href} hreflang={link.hreflang} />)}

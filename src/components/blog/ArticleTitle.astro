---
import LbHeading from '../common/LbHeading.astro';

interface Props {
  title: string;
  anchor?: string;
}
const { title, anchor } = Astro.props;
const headingClass = 'mb-4 max-w-reading text-balance text-3xl font-bold leading-tight text-stone-900 dark:text-stone-100 sm:text-4xl';
---

{anchor ? (
  <div id={anchor + '--text'} class="flex items-start gap-2 scroll-mt-20">
    <LbHeading as="h1" id={anchor} class={headingClass + ' min-w-0 flex-1 scroll-mt-20'} text={title} />
    <a href={'#' + anchor} aria-labelledby={anchor} data-astro-reload
      class="inline-flex min-h-[44px] min-w-[44px] shrink-0 items-center justify-center rounded-sm text-stone-600 underline focus-visible:outline dark:text-stone-300">
      <span aria-hidden="true">#</span>
    </a>
  </div>
) : <LbHeading as="h1" class={headingClass} text={title} />}

---
interface Cta {
  label: string;
  href: string;
  isExternal?: boolean;
  primary?: boolean;
}

interface Props {
  heading: string;
  lead?: string;
  ctas: Cta[];
  // 読み物の page では列（48rem）に揃える。既定は LP の今までの幅。
  width?: 'content' | 'reading';
}

const { heading, lead, ctas, width = 'content' } = Astro.props;
const containerClass =
  width === 'reading'
    ? 'mx-auto max-w-reading px-4 sm:px-6 lg:px-8'
    : 'mx-auto max-w-2xl px-4 sm:px-6 lg:max-w-content lg:px-8';
---

<section class="py-16 sm:py-20">
  <div class={containerClass}>
    <div
      class="flex flex-col items-center gap-8 rounded-3xl bg-primary-500/10 px-6 py-12 text-center dark:bg-primary-400/10 sm:px-12 sm:py-16"
    >
      <div class="flex max-w-2xl flex-col gap-4 lg:max-w-content">
        <h2 class="text-balance text-2xl font-medium tracking-tight sm:text-3xl">{heading}</h2>
        {lead && (
          <p class="text-pretty text-lg leading-relaxed text-primary-950/70 dark:text-primary-200/70">{lead}</p>
        )}
      </div>
      <div class="flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        {
          ctas.map((cta) =>
            cta.primary ? (
              <a
                href={cta.href}
                target={cta.isExternal ? '_blank' : undefined}
                rel={cta.isExternal ? 'noopener noreferrer' : undefined}
                class="inline-flex min-h-[48px] w-full max-w-sm items-center justify-center text-balance rounded-full border border-transparent bg-[#2d4a6b] px-5 py-3 text-center text-sm font-medium sm:text-base text-white transition hover:bg-[#1e3350] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#2d4a6b] sm:w-auto"
              >
                <span class="block text-balance">{cta.label}</span>
              </a>
            ) : (
              <a
                href={cta.href}
                target={cta.isExternal ? '_blank' : undefined}
                rel={cta.isExternal ? 'noopener noreferrer' : undefined}
                class="inline-flex min-h-[48px] w-full max-w-sm items-center justify-center text-balance rounded-full border border-primary-950/20 px-5 py-3 text-center text-sm font-medium sm:text-base text-primary-950 transition hover:bg-primary-500/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 dark:border-primary-200/20 dark:text-primary-200 dark:hover:bg-primary-400/10 sm:w-auto"
              >
                <span class="block text-balance">{cta.label}</span>
              </a>
            )
          )
        }
      </div>
    </div>
  </div>
</section>

---
import { ViewTransitions } from 'astro:transitions';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import WebVitals from '../components/performance/WebVitals.astro';
import Analytics from '../components/analytics/Analytics.astro';
import AlpineInit from '../components/layout/AlpineInit.astro';
import ThemeInit from '../components/layout/ThemeInit.astro';
import { getCurrentLocale } from '../utils/i18n';
import { generateKeywords } from '../utils/blog-seo';
import { buildBlogHreflang, countContentWords } from '../utils/blog-structured-data';
import { ORGANIZATION_NAMES } from '../config/organization';
import BlogSeoMeta from '../components/blog/seo/BlogSeoMeta.astro';
import BlogOgp from '../components/blog/seo/BlogOgp.astro';
import BlogStructuredData from '../components/blog/seo/BlogStructuredData.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

type BlogPostData = {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  author: string;
  category: string;
  tags: string[];
  image?: { url: string; alt: string };
  ogImage?: string;
  lang: string;
  featured?: boolean;
};

type BlogPost = CollectionEntry<'blog'> | {
  slug: string;
  data: BlogPostData;
};

interface Props {
  post: BlogPost;
  relatedPosts?: BlogPost[];
  nextPost?: BlogPost;
  prevPost?: BlogPost;
}

const { post } = Astro.props;
const currentLocale = getCurrentLocale(Astro.url);
const { title, description, pubDate, updatedDate, author, category, tags, image, ogImage } = post.data;

// Use SNS-compatible PNG OGP image if no custom ogImage is set. SVG routes remain available.
const finalOgImage = ogImage || new URL(`/og/${post.slug}.png`, Astro.site).toString();
const usesGeneratedOgImage = !ogImage;

const keywords = generateKeywords(tags, category, currentLocale);
// JSON-LD の wordCount は本文から数える（以前は description 由来の推定値 × 200 で全記事 200 固定だった）。
const body = 'body' in post ? post.body : undefined;
const wordCount = body ? countContentWords(body, currentLocale) : undefined;

// この記事が翻訳されている言語を算出する（言語切替の飛び先判定用・#307）。記事の slug は
// "{lang}/{cleanSlug}" 形式。同じ cleanSlug を持つ記事が存在する言語だけを対象にすることで、
// 未翻訳の言語ではヘッダーの言語切替がホームにフォールバックし、404 を避ける。
const ALL_LOCALES = ['ja', 'en', 'zh', 'ko', 'es'] as const;
const cleanSlug = post.slug.replace(/^[a-z]{2}\//, '');
const allBlogPosts = await getCollection('blog', ({ data }) => !data.isDraft);
const articleLocales = ALL_LOCALES.filter((loc) =>
  allBlogPosts.some((p) => p.data.lang === loc && p.slug.replace(/^[a-z]{2}\//, '') === cleanSlug)
);
// hreflang も同じ articleLocales から出す（実在しない言語版を指して 404 にしない。ADR-0017）。
const hreflangLinks = buildBlogHreflang(cleanSlug, articleLocales);

// 検索結果に出るタイトル。会社名表記をロケール別の正式表記に統一（#306）。ブログは全5言語で
// 出力されるため、日本語ブランドを全言語に固定してはいけない（英語記事に全角日本語が混入する）。
// i18n の meta タイトルと同じ規約: CJK は全角｜、ラテンは半角パイプ。
// なお全角｜を <title> のテンプレートに直書きすると astro-compress が誤動作しサフィックスが
// </head> の外へ漏れるため、必ず1つの文字列変数として組み立ててから {pageTitle} で描画する。
// 表記の正本は config/organization.ts の ORGANIZATION_NAMES（JSON-LD の Organization.name と共有）。
const brandSep = currentLocale === 'en' || currentLocale === 'es' ? ' | ' : '｜';
const pageTitle = `${title}${brandSep}${ORGANIZATION_NAMES[currentLocale]}`;

---

<!doctype html>
<html lang={currentLocale} x-data :class="{ 'dark': $store.theme?.isDark || false }">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Cor.inc" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <BlogSeoMeta
      description={description}
      keywords={keywords}
      author={author}
      pubDate={pubDate}
      updatedDate={updatedDate}
      category={category}
      tags={tags}
      hreflangLinks={hreflangLinks}
    />

    <BlogOgp
      title={title}
      description={description}
      ogImage={finalOgImage}
      ogImageAlt={title}
      ogImageWidth={usesGeneratedOgImage ? 1200 : undefined}
      ogImageHeight={usesGeneratedOgImage ? 630 : undefined}
      currentLocale={currentLocale}
    />
    
    <!-- Structured Data -->
    <BlogStructuredData
      title={title}
      description={description}
      keywords={keywords}
      author={author}
      pubDate={pubDate}
      updatedDate={updatedDate}
      category={category}
      tags={tags}
      image={image}
      wordCount={wordCount}
      currentLocale={currentLocale}
    />
    
    <!-- KaTeX CSS for math rendering -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
    
    {/* pageTitle は frontmatter で組み立て済み（全角｜直書きは圧縮ツールで壊れるため）。 */}
    <title>{pageTitle}</title>
    <ViewTransitions />
    <!-- テーマ（dark クラス）を初回描画前に適用（FOUC 防止。Alpine 非依存） -->
    <ThemeInit />
    
    <!-- Include critical CSS from parent layout -->
    <style is:inline>
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* CJK/多言語の改行制御を通常Layoutと揃える。 */
      h1, h2, h3,
      .type-heading {
        word-break: auto-phrase;
        overflow-wrap: anywhere;
        line-break: strict;
        text-wrap: balance;
      }
      p, li, dd, figcaption,
      .type-copy {
        word-break: auto-phrase;
        overflow-wrap: break-word;
        line-break: strict;
        text-wrap: pretty;
      }
      .type-action {
        word-break: auto-phrase;
        overflow-wrap: anywhere;
        line-break: strict;
        text-wrap: balance;
      }
      /* ブランド語「きょうそう」など、語の途中で折らない範囲に使う。 */
      .nowrap,
      .type-keep {
        white-space: nowrap;
      }
      .line-clamp-2,
      .line-clamp-3 {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .line-clamp-2 {
        -webkit-line-clamp: 2;
      }
      .line-clamp-3 {
        -webkit-line-clamp: 3;
      }
      
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 400;
        font-display: optional;
        src: url('https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuLyfAZ9hiA.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      
      @font-face {
        font-family: 'Inter';
        font-style: normal;
        font-weight: 500;
        font-display: optional;
        src: url('https://fonts.gstatic.com/s/inter/v13/UcCO3FwrK3iLTeHuS_fvQtMwCp50KnMw2boKoduKmMEVuI6fAZ9hiA.woff2') format('woff2');
        unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
      }
      
      .font-loaded body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      
      [x-cloak] { display: none !important; }
      
      /* Blog specific styles */
      .prose {
        max-width: none;
      }

      .prose :where(h1, h2, h3) {
        word-break: auto-phrase;
        overflow-wrap: anywhere;
        line-break: strict;
        text-wrap: balance;
      }

      .prose :where(p, li, dd, figcaption) {
        word-break: auto-phrase;
        overflow-wrap: break-word;
        line-break: strict;
        text-wrap: pretty;
        line-height: 1.9;
      }

      .prose :where(a) {
        overflow-wrap: anywhere;
      }

      .prose :where(h2) {
        border-top: 1px solid #e7e5e4;
        margin-top: 3rem;
        padding-top: 2rem;
      }

      .dark .prose :where(h2) {
        border-top-color: #44403c;
      }

      .prose :where(blockquote) {
        border-left-color: #2563eb;
        background-color: #fafaf9;
        border-radius: 0.5rem;
        padding: 1rem 1.25rem;
      }

      .dark .prose :where(blockquote) {
        background-color: #1c1917;
      }

      .prose :where(img) {
        border-radius: 0.5rem;
        border: 1px solid #e7e5e4;
      }

      .dark .prose :where(img) {
        border-color: #44403c;
      }

      .prose pre {
        background-color: #282a36;
        border-radius: 0.5rem;
        padding: 1rem;
        overflow-x: auto;
      }
      
      /* Light mode: override background and adjust colors */
      html:not(.dark) .prose pre {
        background-color: #f6f8fa !important;
        border: 1px solid #e5e7eb;
      }
      
      /* Light mode: darken code colors for better contrast */
      html:not(.dark) .prose pre code {
        filter: brightness(0.6) saturate(1.5) contrast(1.2);
      }
      
      /* Keep pre code background transparent */
      .prose pre code {
        background-color: transparent !important;
      }
      
      .prose code {
        background-color: #f1f5f9;
        padding: 0.125rem 0.25rem;
        border-radius: 0.25rem;
        font-size: 0.875em;
      }
      
      .dark .prose code {
        background-color: #334155;
      }
      
      .prose pre code {
        background-color: transparent;
        padding: 0;
      }
      
      .prose a {
        color: #3b82f6;
        text-decoration: underline;
      }
      
      .prose a:hover {
        color: #2563eb;
      }
      
      .dark .prose a {
        color: #60a5fa;
      }
      
      .dark .prose a:hover {
        color: #93bbfc;
      }
      
      /* Link Card Styles */
      .remark-link-card-plus__container {
        margin: 1.5rem 0;
        border-radius: 0.5rem;
        overflow: hidden;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
        background-color: #fafaf9;
        border: 1px solid #e7e5e4;
      }
      
      .remark-link-card-plus__container:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        border-color: #3b82f6;
      }
      
      .dark .remark-link-card-plus__container {
        background-color: #292524;
        border: 1px solid #44403c;
      }
      
      .dark .remark-link-card-plus__container:hover {
        border-color: #60a5fa;
      }
      
      .remark-link-card-plus__card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        min-height: 0;
      }
      
      .remark-link-card-plus__main {
        padding: 1rem;
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }
      
      .remark-link-card-plus__thumbnail {
        flex-shrink: 0;
        width: 100%;
        height: 10rem;
        overflow: hidden;
      }
      
      .remark-link-card-plus__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.15s ease;
      }
      
      .remark-link-card-plus__card:hover .remark-link-card-plus__image {
        transform: scale(1.05);
      }
      
      .remark-link-card-plus__content {
        margin-bottom: 0.75rem;
        min-width: 0;
      }
      
      .remark-link-card-plus__title {
        font-weight: 600;
        color: #1c1917;
        margin-bottom: 0.5rem;
        font-size: 1rem;
        line-height: 1.5;
        word-break: auto-phrase;
        overflow-wrap: anywhere;
        line-break: strict;
        text-wrap: balance;
      }
      
      .dark .remark-link-card-plus__title {
        color: #f5f5f4;
      }
      
      .remark-link-card-plus__description {
        color: #57534e;
        font-size: 0.875rem;
        line-height: 1.4;
        word-break: auto-phrase;
        overflow-wrap: break-word;
        line-break: strict;
        text-wrap: pretty;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      
      .dark .remark-link-card-plus__description {
        color: #a8a29e;
      }
      
      .remark-link-card-plus__meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        min-width: 0;
      }
      
      .remark-link-card-plus__favicon {
        width: 1rem;
        height: 1rem;
        border-radius: 0.125rem;
      }
      
      .remark-link-card-plus__url {
        color: #78716c;
        font-size: 0.75rem;
        font-weight: 500;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }
      
      .dark .remark-link-card-plus__url {
        color: #a8a29e;
      }

      @media (min-width: 640px) {
        .remark-link-card-plus__card {
          flex-direction: row;
          min-height: 120px;
        }

        .remark-link-card-plus__thumbnail {
          width: 120px;
          height: 120px;
        }
      }
    </style>

    <Analytics />
  </head>
  <body class="bg-primary-50 text-primary-950 antialiased transition dark:bg-primary-950 dark:text-primary-200">
    <Header availableLocales={articleLocales} />
    <main>
      <slot />
    </main>
    <Footer />
    <WebVitals />
    
    <!-- Alpine.js（npm 同梱。ストア登録 → start を 1 モジュールで順序保証） -->
    <AlpineInit />
    
    <noscript>
      <style>[x-cloak]{ display: block !important; }</style>
      <div style="background:#fff3cd;color:#856404;padding:1em;border-radius:8px;margin:1em 0;text-align:center;">
        JavaScriptが無効なため、一部機能がご利用いただけません。
      </div>
    </noscript>
    
    <script data-cfasync="false">
      if ('fonts' in document) {
        document.fonts.ready.then(() => {
          document.documentElement.classList.add('font-loaded');
        });
      }
    </script>
  </body>
</html>

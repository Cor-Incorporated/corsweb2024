---
import Layout from '../layouts/Layout.astro';
import LbHeading from '../components/common/LbHeading.astro';
import LbText from '../components/common/LbText.astro';
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../utils/i18n';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
const p = t.privacy;
const securityUrl = getLocalizedUrl('/security', currentLocale);
---

<Layout
  description={t.meta.privacy.description}
  title={t.meta.privacy.title}
>
  <div class="mx-auto max-w-reading px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="flex flex-col gap-4 pb-16 text-start sm:pb-20">
      <LbHeading as="h1" class="type-heading text-3xl font-medium tracking-tight sm:text-4xl md:text-5xl" text="個人情報保護方針（プライバシーポリシー）" />
      <p class="type-copy text-base text-primary-950/70 dark:text-primary-200/70">{p.lastUpdate}</p>
    </div>

    <div class="type-copy text-base leading-[1.8] sm:text-lg">
      {
        p.note && (
          <p class="mb-6 rounded-md border border-primary-900/15 bg-primary-900/[0.03] px-4 py-3 text-sm dark:border-primary-300/15 dark:bg-primary-300/[0.04]">
            {p.note}
          </p>
        )
      }

      <LbText class="mb-4" text={p.intro} />

      <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={p.businessTitle} />
      <div class="overflow-x-auto">
        <table class="w-full max-w-full border-collapse text-left text-sm sm:text-base">
          <tbody>
            {
              Array.isArray(p.businessTable) && p.businessTable.map((row) => (
                <tr class="border-b border-primary-900/10 align-top dark:border-primary-300/10">
                  <th class="w-1/3 py-3 pr-4 font-medium">{row.label}</th>
                  <td class="py-3">{row.value}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={p.purposeTitle} />
      <LbText class="mb-6" text={p.purposeLead} />
      <div class="flex flex-col gap-8">
        {
          Array.isArray(p.purposeGroups) && p.purposeGroups.map((group) => (
            <div>
              <LbHeading as="h3" class="type-heading mb-3 text-lg font-medium" text={group.title} />
              <dl class="flex flex-col gap-2">
                {group.lines.map((line) => (
                  <div>
                    <dt class="font-medium">{line.label}</dt>
                    <dd>{line.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
      <p class="mt-6 text-sm text-primary-950/70 dark:text-primary-200/70">{p.purposeNote}</p>

      {
        Array.isArray(p.sections) && p.sections.map((section) => (
          <section id={'id' in section ? section.id : undefined} class="scroll-mt-24">
            <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={section.title} />
            {Array.isArray(section.body) && section.body.map((para) => <LbText class="mb-4" text={para} />)}
            {Array.isArray(section.list) && (
              <ul class="mb-4 list-inside list-disc space-y-3">
                {section.list.map((item) => (
                  <LbText as="li" text={item} />
                ))}
              </ul>
            )}
            {Array.isArray(section.bodyAfter) && section.bodyAfter.map((para) => <LbText class="mb-4" text={para} />)}
            {/* 参照リンク（任意）。本文は素のテキストとして描画されるため、オプトアウト等の
                「実際に到達できる必要がある」導線はここで anchor として出す。
                label / href とも文字列として扱い、HTML は挿入しない。 */}
            {Array.isArray(section.links) && (
              <ul class="mb-4 list-inside list-disc space-y-2">
                {section.links.map((link) => (
                  <li>
                    <a
                      class="font-medium underline underline-offset-4"
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))
      }

      <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={p.inquiryTitle} />
      <LbText class="mb-6" text={p.inquiryLead} />
      <div class="overflow-x-auto">
        <table class="w-full max-w-full border-collapse text-left text-sm sm:text-base">
          <tbody>
            {
              Array.isArray(p.inquiryTable) && p.inquiryTable.map((row) => (
                <tr class="border-b border-primary-900/10 align-top dark:border-primary-300/10">
                  <th class="w-1/3 py-3 pr-4 font-medium">{row.label}</th>
                  <td class="py-3">
                    {/* かつて最終行（連絡方法）を丸ごと /contact へのリンクにしていたが、
                        現在この行は開示等の請求先メールアドレスを含むため、押すと想定と違う場所へ
                        飛ぶ誤った導線になる。素のテキストとして描画する。 */}
                    {row.value}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={p.revisionTitle} />
      {Array.isArray(p.revisionBody) && p.revisionBody.map((para) => <LbText class="mb-4" text={para} />)}

      <LbText
        class="mb-4 mt-8"
        parts={[
          { text: p.securityLinkPrefix },
          { text: p.securityLinkText, href: securityUrl },
          { text: p.securityLinkSuffix },
        ]}
      />

      <hr class="my-10 border-primary-900/15 dark:border-primary-300/15" />
      <p class="text-sm text-primary-950/70 dark:text-primary-200/70">{p.footer}</p>
      <p class="mt-2 text-sm text-primary-950/70 dark:text-primary-200/70">{p.footerNote}</p>
    </div>
  </div>
</Layout>

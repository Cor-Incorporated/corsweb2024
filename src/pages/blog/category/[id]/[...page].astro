---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { blogIndexLocales } from '../../../../utils/blog-i18n';
import BlogArchiveHeader from '../../../../components/blog/BlogArchiveHeader.astro';
import BlogCategoryNav from '../../../../components/blog/BlogCategoryNav.astro';
import PostCard from '../../../../components/blog/PostCard.astro';
import { BLOG_CATEGORIES, getCategoryDescription, getCategoryLabel } from '../../../../config/categories';
import Layout from '../../../../layouts/Layout.astro';
import { getCurrentLocale } from '../../../../utils/i18n';
import { ORGANIZATION_NAMES } from '../../../../config/organization';

interface Props {
  page: Page<CollectionEntry<'blog'>>;
  id: string;
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  // Get all Japanese blog posts from Content Collections
  const allPosts = await getCollection('blog', ({ data }) => {
    return data.lang === 'ja' && !data.isDraft;
  });
  
  // Get available categories
  const categories = Array.from(new Set(allPosts.map(p => p.data.category)));

  const paths = categories.flatMap((category: string) => {
    const filtered = allPosts.filter(p => p.data.category === category);
    const sorted = filtered.sort(
      (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    );
    return paginate(sorted, { 
      pageSize: 12, 
      params: { id: category },
      props: { categoryId: category }
    });
  });
  return paths;
};

const { page } = Astro.props as Props;
const base = import.meta.env.BASE_URL || '';
// `Astro.params.id` が存在すればそれを使用。無い場合は `getStaticPaths` で渡された `categoryId` をフォールバックに使う。
const id: string = Astro.params.id ?? (Astro.props as any).categoryId ?? '';
const currentLocale = getCurrentLocale(Astro.url);

const isKnownCategory = BLOG_CATEGORIES.some(cat => cat.id === id);
const categoryLabel = isKnownCategory 
  ? getCategoryLabel(id, currentLocale === 'ja' ? 'ja' : 'en')
  : (currentLocale === 'ja' ? 'カテゴリーが見つかりません' : 'Category Not Found');
const pageTitle = `${categoryLabel}｜ブログ｜${ORGANIZATION_NAMES.ja}`;
const categoryDesc = getCategoryDescription(id, currentLocale === 'ja' ? 'ja' : 'en');
const pageDescription = categoryDesc || (currentLocale === 'ja'
  ? `${categoryLabel} に属するブログ記事一覧` : `Blog posts in ${categoryLabel}`);
const countLabel = page.total > page.size
  ? `${page.total}記事中 ${page.start + 1}-${page.end + 1}記事を表示`
  : `${page.total}記事`;

// 言語切替の飛び先を、そのページ番号/タグ/カテゴリが存在する言語だけに限定する（#307）。
const availableLocales = await blogIndexLocales((d) => d.category === id, page.currentPage);
---

<Layout title={pageTitle} description={pageDescription} availableLocales={availableLocales}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <BlogArchiveHeader
      eyebrow="Category"
      title={categoryLabel}
      description={pageDescription}
      countLabel={countLabel}
      backHref="/blog"
      backLabel="ブログ一覧に戻る"
    />

    <BlogCategoryNav currentCategory={id} />

    <!-- 記事グリッド -->
    <div class="mx-auto flex max-w-5xl flex-col gap-4">
      {page.data.map(post => (
        <PostCard post={post} variant="feed" />
      ))}
    </div>

    <!-- ページネーション -->
    {page.lastPage > 1 && (
      <nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="Pagination">
        {page.url.prev ? (
          <a
            href={`${base}blog/category/${id}${page.url.prev}`}
            class="rounded-lg bg-white px-3 py-2 text-sm font-medium text-stone-700 ring-1 ring-stone-200 hover:bg-stone-50 dark:bg-stone-900 dark:text-stone-200 dark:ring-stone-800 dark:hover:bg-stone-800"
          >
            {currentLocale === 'ja' ? '前へ' : 'Previous'}
          </a>
        ) : (
          <span
            class="rounded-lg px-3 py-2 text-sm font-medium cursor-not-allowed bg-stone-100 text-stone-400 dark:bg-stone-700 dark:text-stone-500"
          >
            {currentLocale === 'ja' ? '前へ' : 'Previous'}
          </span>
        )}

        <div class="flex gap-1">
          {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(num => (
            <a
              href={`${base}blog/category/${id}${num === 1 ? '' : '/' + num}`}
              class={`rounded-lg px-3 py-2 text-sm font-medium ${
                num === page.currentPage
                  ? 'bg-stone-950 text-white dark:bg-stone-100 dark:text-stone-950'
                  : 'bg-white text-stone-700 ring-1 ring-stone-200 hover:bg-stone-50 dark:bg-stone-900 dark:text-stone-200 dark:ring-stone-800 dark:hover:bg-stone-800'
              }`}
              aria-current={num === page.currentPage ? 'page' : undefined}
            >
              {num}
            </a>
          ))}
        </div>

        {page.url.next ? (
          <a
            href={`${base}blog/category/${id}${page.url.next}`}
            class="rounded-lg bg-white px-3 py-2 text-sm font-medium text-stone-700 ring-1 ring-stone-200 hover:bg-stone-50 dark:bg-stone-900 dark:text-stone-200 dark:ring-stone-800 dark:hover:bg-stone-800"
          >
            {currentLocale === 'ja' ? '次へ' : 'Next'}
          </a>
        ) : (
          <span
            class="rounded-lg px-3 py-2 text-sm font-medium cursor-not-allowed bg-stone-100 text-stone-400 dark:bg-stone-700 dark:text-stone-500"
          >
            {currentLocale === 'ja' ? '次へ' : 'Next'}
          </span>
        )}
      </nav>
    )}
  </div>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import ProposalPage from '../../components/industry/ProposalPage.astro';
import { getCurrentLocale, getTranslations } from '../../utils/i18n';

const currentLocale = getCurrentLocale(Astro.url);
const t = getTranslations(currentLocale);
---

<Layout
  description={t.meta.industryShigyo.description}
  title={t.meta.industryShigyo.title}
  availableLocales={['ja', 'en', 'zh', 'ko', 'es']}
>
  <ProposalPage industry="shigyo" />
</Layout>

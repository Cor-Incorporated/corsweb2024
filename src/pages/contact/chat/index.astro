---
import Layout from '../../../layouts/Layout.astro';
import { getCurrentLocale } from '../../../utils/i18n';

const queryLocale = Astro.url.searchParams.get('locale');
const currentLocale = queryLocale === 'en' ? 'en' : getCurrentLocale(Astro.url);
// このページは Cloudia SPA が配信されていないときだけ出る。ここから /contact/ へ戻すと
// 「/contact/ の CTA → /contact/chat/ → /contact/ → …」の無限ループになるため、導線を張らずに
// 終端させる（ランチャー内で開かれた場合は CloudiaLauncher 側のフォールバックが別途出る）。
// 問い合わせは Cloudia に一本化しており（ADR-0005 §6 撤回・2026-09-13）、案内できる代替手段は無い。
// ヘッダー/フッターの通常ナビは Layout が出すので、利用者は行き止まりにはならない。
const copy = currentLocale === 'ja'
  ? {
      title: 'AIチャットを準備しています',
      body: '現在AIチャットをご利用いただけません。お手数ですが、時間をおいて再度お試しください。',
    }
  : {
      title: 'The AI chat is unavailable',
      body: 'The AI chat cannot be reached right now. Please try again in a little while.',
    };
---

{/* analytics=false: このページは Cloudia ランチャーから iframe 読み込みされるため、
    計測タグを出すと同一訪問者に対し Clarity が二重に起動し、幻の /contact/chat/ セッションで
    解析データが汚れる（SSG のため embed=1 クエリはビルド時に判定できず、ここで明示的に落とす）。 */}
<Layout
  description={copy.body}
  title={copy.title}
  availableLocales={['ja']}
  cloudiaLauncher={false}
  analytics={false}
>
  <main class="mx-auto flex min-h-[50vh] max-w-2xl flex-col items-center justify-center gap-5 px-4 py-20 text-center sm:px-6">
    <h1 class="text-3xl font-medium tracking-tight sm:text-4xl">{copy.title}</h1>
    <p class="max-w-lg text-base leading-relaxed text-primary-950/70 dark:text-primary-200/70">{copy.body}</p>
  </main>
</Layout>

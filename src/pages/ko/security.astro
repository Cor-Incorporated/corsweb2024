---
import Layout from '../../layouts/Layout.astro';
import NextStep from '../../components/common/NextStep.astro';
import LbHeading from '../../components/common/LbHeading.astro';
import ScrollableTable from '../../components/common/ScrollableTable.astro';
import LbText from '../../components/common/LbText.astro';
import { getCurrentLocale, getLocalizedUrl, getTranslations } from '../../utils/i18n';
import { getContactUrl } from '../../config/site';

const locale = Astro.props.locale || getCurrentLocale(Astro.url);
const t = getTranslations(locale);
---

<Layout
  description={t.meta.security.description}
  title={t.meta.security.title}
>
  <div class="mx-auto max-w-reading px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
    <div class="flex flex-col gap-4 pb-16 text-start sm:pb-20">
      <LbHeading as="h1" class="type-heading text-3xl font-medium tracking-tight sm:text-4xl md:text-5xl" text={t.security.title} />
      <LbText class="type-copy text-base italic sm:text-lg text-primary-950/70 dark:text-primary-200/70" text={t.security.tagline} />
    </div>
    <div class="type-copy text-base leading-[1.8] sm:text-lg">
      <LbText class="mb-4" text={t.security.lead} />

      <section>
        <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={t.security.basicPolicy.title} />
        {
          t.security.basicPolicy.note && (
            <p class="mb-6 rounded-md border border-primary-900/15 bg-primary-900/[0.03] px-4 py-3 text-sm dark:border-primary-300/15 dark:bg-primary-300/[0.04]">
              {t.security.basicPolicy.note}
            </p>
          )
        }
        {
          Array.isArray(t.security.basicPolicy.preamble) &&
            t.security.basicPolicy.preamble.map((para) => <LbText class="mb-4" text={para} />)
        }
        <LbHeading as="h3" class="type-heading mb-4 mt-8 text-lg font-medium" text={t.security.basicPolicy.guidelinesTitle} />
        <ol class="list-outside list-decimal space-y-3 pl-6">
          {
            Array.isArray(t.security.basicPolicy.guidelines) &&
              t.security.basicPolicy.guidelines.map((item) => <LbText as="li" text={item} />)
          }
        </ol>
        <div class="mt-8 text-end">
          <p>{t.security.basicPolicy.signatureDate}</p>
          <p class="mt-1">{t.security.basicPolicy.signatureCompany}</p>
          <p class="mt-1 font-medium">{t.security.basicPolicy.signatureName}</p>
        </div>
        <p class="mt-6 text-sm text-primary-950/70 dark:text-primary-200/70">{t.security.basicPolicy.meta}</p>
      </section>

      <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={t.security.pillarsTitle} />
      <div class="flex flex-col gap-8">
        {
          Array.isArray(t.security?.pillars) && t.security.pillars.map((pillar) => (
            <div>
              <LbHeading as="h3" class="type-heading mb-2 text-lg font-medium" text={pillar.title} />
              <LbText text={pillar.description} />
            </div>
          ))
        }
      </div>

      <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={t.security.statusTitle} />
      <ul class="list-outside list-disc space-y-4 pl-6">
        <LbText as="li" text={t.security.status.legal} />
        <LbText as="li" text={t.security.status.isms} />
      </ul>

      <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={t.security.aiTitle} />
      <LbText class="mb-4" text={t.security.aiDescription} />

      <LbHeading as="h2" id="security-measures-table" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={t.security.tableTitle} />
      <ScrollableTable labelledBy="security-measures-table">
        <table class="w-full border-collapse text-left text-sm sm:text-base">
          <thead>
            <tr class="border-b border-primary-900/20 dark:border-primary-300/20">
              <th class="py-3 pr-4 font-medium">{t.security.tableHead.area}</th>
              <th class="py-3 pr-4 font-medium">{t.security.tableHead.effort}</th>
              <th class="py-3 font-medium">{t.security.tableHead.state}</th>
            </tr>
          </thead>
          <tbody>
            {
              Array.isArray(t.security?.table) && t.security.table.map((row) => (
                <tr class="border-b border-primary-900/10 dark:border-primary-300/10 align-top">
                  <td class="py-3 pr-4 font-medium">{row.area}</td>
                  <td class="py-3 pr-4">{row.effort}</td>
                  <td class="py-3 whitespace-nowrap">{row.state}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </ScrollableTable>

      <LbHeading as="h2" class="type-heading mb-6 mt-12 text-xl font-medium sm:text-2xl" text={t.security.privacyTitle} />
      <LbText
        class="mb-4"
        parts={[
          { text: t.security.privacyDescription },
          { text: t.security.privacyLinkText, href: getLocalizedUrl('/privacy', locale) },
          { text: t.security.privacySuffix },
        ]}
      />
    </div>
  </div>

  <NextStep
    heading={t.nextStep.security.heading}
    ctas={[{ label: t.nextStep.security.ctaLabel, href: getContactUrl(locale, { source: 'security' }), primary: true }]}
    width="reading"
  />
</Layout>

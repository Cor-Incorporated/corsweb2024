---
import type { GetStaticPaths, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { blogIndexLocales } from '../../../../../utils/blog-i18n';
import BlogArchiveHeader from '../../../../../components/blog/BlogArchiveHeader.astro';
import BlogCategoryNav from '../../../../../components/blog/BlogCategoryNav.astro';
import PostCard from '../../../../../components/blog/PostCard.astro';
import Layout from '../../../../../layouts/Layout.astro';
import { getCategoryLabel, getCategoryDescription } from '../../../../../config/categories';
import { ORGANIZATION_NAMES } from '../../../../../config/organization';

interface Props {
  page: Page<CollectionEntry<'blog'>>;
  /**
   * categoryId is provided via getStaticPaths props and may be undefined when
   * this page is rendered via dynamic routing. It should therefore be optional.
   */
  categoryId?: string;
}

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  // Get all Korean blog posts from Content Collections
  const allPosts = await getCollection('blog', (entry) => {
    return entry.data.lang === 'ko' && !entry.data.isDraft;
  });
  
  // Get available categories
  const categories = Array.from(new Set(allPosts.map(p => p.data.category)));

  const paths = categories.flatMap(category => {
    const filtered = allPosts.filter(p => p.data.category === category);
    const sorted = filtered.sort(
      (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
    );
    return paginate(sorted, { 
      pageSize: 12, 
      params: { id: category as string },
      props: { categoryId: category }
    });
  });
  return paths;
};

const { page, categoryId } = Astro.props as Props;
const id: string = (Astro.params.id as string | undefined) ?? categoryId ?? '';

const categoryLabel = getCategoryLabel(id, 'ko');
const pageTitle = `${categoryLabel}｜블로그｜${ORGANIZATION_NAMES.ko}`;
const categoryDesc = getCategoryDescription(id, 'ko');
const pageDescription = categoryDesc || `${categoryLabel} 카테고리의 블로그 글`;
const countLabel = page.total > page.size
  ? `총 ${page.total}개 중 ${page.start + 1}-${page.end + 1}개 글 표시`
  : `총 ${page.total}개 글`;

// 言語切替の飛び先を、そのページ番号/タグ/カテゴリが存在する言語だけに限定する（#307）。
const availableLocales = await blogIndexLocales((d) => d.category === id, page.currentPage);
---

<Layout title={pageTitle} description={pageDescription} availableLocales={availableLocales}>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <BlogArchiveHeader
      eyebrow="카테고리"
      title={categoryLabel}
      description={pageDescription}
      countLabel={countLabel}
      backHref="/ko/blog"
      backLabel="블로그로 돌아가기"
    />

    <BlogCategoryNav currentCategory={id} />

    <!-- 記事グリッド -->
    <div class="mx-auto flex max-w-5xl flex-col gap-4">
      {page.data.map(post => (
        <PostCard post={post} variant="feed" />
      ))}
    </div>

    <!-- ページネーション -->
    {page.lastPage > 1 && (
      <nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="Pagination">
        <a
          href={page.url.prev ? `/ko/blog/category/${id}/${page.url.prev.replace(/^\//, '')}` : '#'}
          class={`rounded-lg px-3 py-2 text-sm font-medium ${
            !page.url.prev
              ? 'cursor-not-allowed bg-stone-100 text-stone-400 dark:bg-stone-700 dark:text-stone-500'
              : 'bg-white text-stone-700 ring-1 ring-stone-200 hover:bg-stone-50 dark:bg-stone-900 dark:text-stone-200 dark:ring-stone-800 dark:hover:bg-stone-800'
          }`}
          aria-disabled={!page.url.prev}
        >
          이전
        </a>

        <div class="flex gap-1">
          {Array.from({ length: page.lastPage }, (_, i) => i + 1).map(num => (
            <a
              href={num === 1 ? `/ko/blog/category/${id}` : `/ko/blog/category/${id}/${num}`}
              class={`rounded-lg px-3 py-2 text-sm font-medium ${
                num === page.currentPage
                  ? 'bg-stone-950 text-white dark:bg-stone-100 dark:text-stone-950'
                  : 'bg-white text-stone-700 ring-1 ring-stone-200 hover:bg-stone-50 dark:bg-stone-900 dark:text-stone-200 dark:ring-stone-800 dark:hover:bg-stone-800'
              }`}
              aria-current={num === page.currentPage ? 'page' : undefined}
            >
              {num}
            </a>
          ))}
        </div>

        <a
          href={page.url.next ? `/ko/blog/category/${id}/${page.url.next.replace(/^\//, '')}` : '#'}
          class={`rounded-lg px-3 py-2 text-sm font-medium ${
            !page.url.next
              ? 'cursor-not-allowed bg-stone-100 text-stone-400 dark:bg-stone-700 dark:text-stone-500'
              : 'bg-white text-stone-700 ring-1 ring-stone-200 hover:bg-stone-50 dark:bg-stone-900 dark:text-stone-200 dark:ring-stone-800 dark:hover:bg-stone-800'
          }`}
          aria-disabled={!page.url.next}
        >
          다음
        </a>
      </nav>
    )}
  </div>
</Layout>

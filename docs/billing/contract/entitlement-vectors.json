{
  "schema": "cor-entitlement-vectors.v1",
  "note": "ADR-0028 の 3 節の判定表（権利 = services.<サービス> = {from, until, hold}）の試験ベクトル。1 件 = 入力（services の行と日本時間の日付 d）と期待（4 つの結果のどれか）。bd と XESM の試験もこのファイルを読む（M2）。サービス名は plans.json の services[].service と同じ。値は架空で、顧客の情報は書かない。",
  "adr": "docs/adr/ADR-0028-cor-account-billing-foundation.md",
  "judge": "docs/billing/contract/judge.sh",
  "date_zone": "Asia/Tokyo",
  "result_values": ["open", "view_only", "read_export_only", "closed"],
  "precedence": [
    "row_missing",
    "before_from",
    "until_plus_1_to_30",
    "after_until_plus_30",
    "hold",
    "otherwise"
  ],
  "precedence_note": "判定表の行の順に上から当てる。当てはまった行で決まる。だから hold が true でも、終了日の翌日から 30 日の中なら read_export_only、31 日目から後なら closed、開始日より前なら closed になる（hold の行は、それより前の行に当てはまらないときだけ効く）。",
  "required_tags": [
    "row_missing",
    "other_service",
    "from_before",
    "from_day",
    "no_until",
    "until_day",
    "read_window_first",
    "read_window_last",
    "read_window_after",
    "hold",
    "hold_outside_until",
    "month_end",
    "leap",
    "services_not_object",
    "row_not_object",
    "from_bad",
    "until_bad",
    "hold_bad",
    "extra_key"
  ],
  "vectors": [
